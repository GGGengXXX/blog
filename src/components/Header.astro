---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import PreferenceControls from './PreferenceControls.astro';
import WeatherSky from './WeatherSky.astro';

const base = import.meta.env.BASE_URL;
---

<WeatherSky />
<header>
	<nav>
		<a class="brand" href={base} aria-label={SITE_TITLE}>
			<span class="brand-mark" aria-hidden="true">G</span>
			<span class="brand-text">GGGengXXX</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/"><span data-locale="zh">花园</span><span data-locale="en">Garden</span></HeaderLink>
			<HeaderLink href="/blog"><span data-locale="zh">归档</span><span data-locale="en">Archive</span></HeaderLink>
			<HeaderLink href="/lab"><span data-locale="zh">实验</span><span data-locale="en">Lab</span></HeaderLink>
			<HeaderLink href="/game"><span data-locale="zh">游戏</span><span data-locale="en">Game</span></HeaderLink>
			<HeaderLink href="/about"><span data-locale="zh">关于</span><span data-locale="en">About</span></HeaderLink>
		</div>
		<div class="social-links">
			<PreferenceControls />
			<a href="https://github.com/GGGengXXX" target="_blank">
				<span class="sr-only">Go to GGGengXXX on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		margin: 0;
		padding: 0 1.25rem;
		background: color-mix(in srgb, var(--paper) 86%, transparent);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(18px);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 68px;
		max-width: 1180px;
		margin: 0 auto;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.58rem;
		min-width: 0;
		padding: 0;
		color: var(--ink);
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.brand:hover {
		color: var(--ink);
	}
	.brand-mark {
		display: inline-grid;
		place-items: center;
		width: 2.18rem;
		height: 2.18rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: var(--ink);
		color: var(--inverse-text);
		font-size: 0.95rem;
		line-height: 1;
	}
	.brand-text {
		white-space: nowrap;
	}
	nav a:not(.brand) {
		padding: 0.56rem 0.68rem;
		color: var(--ink);
		border: 1px solid transparent;
		border-radius: 999px;
		font-size: 0.9rem;
		line-height: 1;
		text-decoration: none;
	}
	nav a:not(.brand).active {
		background: var(--panel-strong);
		border-color: var(--line);
		text-decoration: none;
		color: var(--red);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	@media (max-width: 720px) {
		header {
			position: static;
			padding: 0.35rem 0.75rem;
		}
		nav {
			flex-wrap: wrap;
			gap: 0.55rem;
			min-height: 58px;
		}
		.brand-text {
			display: none;
		}
		.internal-links {
			order: 3;
			width: 100%;
			overflow-x: auto;
			padding-bottom: 0.18rem;
		}
		nav a:not(.brand) {
			padding: 0.48rem 0.55rem;
			font-size: 0.84rem;
			white-space: nowrap;
		}
		.social-links a {
			display: none;
		}
	}
</style>
