---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { categoryLabels, postText } from '../lib/site-data';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & { entryId: string; headings?: Heading[]; bodyLength?: number };

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	mood,
	tags,
	entryId,
	headings = [],
	bodyLength = 0,
} = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const readingMinutes = Math.max(1, Math.round(bodyLength / 520));
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			.progress-track {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 40;
				width: 100vw;
				max-width: 100vw;
				height: 3px;
				background: transparent;
				overflow: hidden;
			}

			.progress-bar {
				display: block;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, var(--red), var(--gold), var(--blue));
				transform: scaleX(0);
				transform-origin: left;
			}

			.post-shell {
				width: min(1220px, calc(100% - 2rem));
			}

			.post-hero {
				display: grid;
				grid-template-columns: minmax(0, 0.92fr) minmax(280px, 0.48fr);
				gap: 1rem;
				align-items: stretch;
				margin-bottom: 1rem;
			}

			.post-title {
				padding: clamp(1.25rem, 4vw, 2.6rem);
				background:
					linear-gradient(145deg, var(--panel-strong), color-mix(in srgb, var(--paper-deep) 30%, transparent)),
					var(--panel);
			}

			.date {
				margin-bottom: 1rem;
				color: var(--muted);
				font-size: 0.9rem;
			}

			.last-updated-on {
				margin-top: 0.18rem;
				font-style: italic;
			}

			.post-title h1 {
				max-width: 10.8ch;
				margin-bottom: 0.75rem;
				font-size: clamp(2.8rem, 7vw, 6.8rem);
			}

			.post-title p {
				max-width: 780px;
				color: var(--ink-soft);
				font-size: clamp(1.04rem, 2vw, 1.28rem);
			}

			.meta-line {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-top: 1.2rem;
			}

			.hero-panel {
				position: relative;
				min-height: 360px;
				overflow: hidden;
				background: var(--inverse);
				color: var(--inverse-text);
			}

			.hero-panel img {
				width: 100%;
				height: 100%;
				min-height: 360px;
				object-fit: cover;
				border-radius: 0;
				filter: saturate(0.95) contrast(1.04);
			}

			.hero-panel.empty {
				display: grid;
				place-items: center;
				padding: 2rem;
			}

			.hero-panel.empty::before {
				content: "";
				position: absolute;
				width: 18rem;
				aspect-ratio: 1;
				border: 1px solid rgba(255, 248, 232, 0.18);
				border-radius: 999px;
			}

			.hero-panel strong {
				position: relative;
				z-index: 1;
				max-width: 8ch;
				font-size: clamp(2.2rem, 5vw, 4.8rem);
				line-height: 0.96;
			}

			.post-grid {
				display: grid;
				grid-template-columns: minmax(180px, 0.24fr) minmax(0, var(--reading)) minmax(180px, 0.24fr);
				gap: 1rem;
				align-items: start;
			}

			.reading-rail,
			.toc {
				position: sticky;
				top: 88px;
				padding: 1rem;
			}

			.reading-rail {
				display: grid;
				gap: 0.75rem;
			}

			.rail-item {
				padding: 0.85rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel);
			}

			.rail-item strong {
				display: block;
				font-size: 1.45rem;
				line-height: 1;
			}

			.rail-item span {
				color: var(--muted);
				font-size: 0.8rem;
			}

			.article-prose {
				width: min(var(--reading), 100%);
				padding: clamp(1.2rem, 4vw, 2.4rem);
				color: var(--ink-soft);
				overflow-x: auto;
			}

			.article-prose :global(> *:first-child) {
				margin-top: 0;
			}

			.article-prose :global(p),
			.article-prose :global(li) {
				font-size: 1.03rem;
				line-height: 1.82;
			}

			.article-prose :global(h2) {
				margin-top: 2.6rem;
				padding-top: 0.8rem;
				color: var(--ink);
				font-size: clamp(1.8rem, 3.4vw, 2.65rem);
				border-top: 1px solid var(--line);
			}

			.article-prose :global(h3) {
				margin-top: 2rem;
				color: var(--ink);
				font-size: clamp(1.35rem, 2.2vw, 1.75rem);
			}

			.article-prose :global(a) {
				font-weight: 700;
			}

			.article-prose :global(ul),
			.article-prose :global(ol) {
				padding-left: 1.3rem;
			}

			.article-prose :global(li + li) {
				margin-top: 0.35rem;
			}

			.article-prose :global(img) {
				margin: 1.8rem auto;
				box-shadow: var(--soft-shadow);
			}

			.article-prose :global(.katex-display) {
				max-width: 100%;
				overflow-x: auto;
				overflow-y: hidden;
				padding-bottom: 0.35rem;
			}

			.article-prose :global(.katex-display > .katex) {
				white-space: nowrap;
			}

			.article-prose :global(.callout),
			.article-prose :global(.interactive-note) {
				margin: 1.7rem 0;
				padding: 1rem;
				border: 1px solid var(--line);
				border-left: 5px solid var(--blue);
				border-radius: var(--radius);
				background: color-mix(in srgb, var(--paper-soft) 74%, transparent);
			}

			.toc h2 {
				margin-bottom: 0.75rem;
				font-size: 0.78rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}

			.toc nav {
				display: grid;
				gap: 0.22rem;
			}

			.toc a {
				display: block;
				padding: 0.38rem 0.5rem;
				border-left: 2px solid transparent;
				border-radius: 0 6px 6px 0;
				color: var(--muted);
				font-size: 0.86rem;
				line-height: 1.28;
				text-decoration: none;
			}

			.toc a[data-depth='3'] {
				padding-left: 1.1rem;
				font-size: 0.8rem;
			}

			.toc a.is-active,
			.toc a:hover {
				border-left-color: var(--red);
				background: color-mix(in srgb, var(--paper-deep) 35%, transparent);
				color: var(--ink);
			}

			.toc-empty {
				color: var(--muted);
				font-size: 0.86rem;
			}

			@media (max-width: 1080px) {
				.post-grid {
					grid-template-columns: minmax(0, 1fr);
				}

				.reading-rail {
					position: static;
					grid-template-columns: repeat(3, 1fr);
					order: 2;
				}

				.article-prose {
					order: 1;
					width: 100%;
				}

				.toc {
					position: static;
					order: 3;
				}
			}

			@media (max-width: 820px) {
				.post-shell {
					width: min(100% - 1rem, 1220px);
				}

				.post-hero {
					grid-template-columns: 1fr;
				}

				.post-title h1 {
					font-size: 2.9rem;
				}

				.reading-rail {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<div class="progress-track" aria-hidden="true"><span class="progress-bar" id="readingProgress"></span></div>
		<Header />
		<main class="post-shell">
			<article>
				<header class="post-hero">
					<div class="post-title surface">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										<span data-locale="zh">更新于</span><span data-locale="en">Last updated on</span> <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>
							<span data-locale="zh">{title}</span>
							<span data-locale="en">{postText[entryId]?.title ?? title}</span>
						</h1>
						<p>
							<span data-locale="zh">{description}</span>
							<span data-locale="en">{postText[entryId]?.description ?? description}</span>
						</p>
						<div class="meta-line">
							<span class="pill">
								<span data-locale="zh">{categoryLabels[category].zh}</span>
								<span data-locale="en">{categoryLabels[category].en}</span>
							</span>
							{mood && (
								<span class="pill">
									<span data-locale="zh">{mood}</span>
									<span data-locale="en">{postText[entryId]?.mood ?? mood}</span>
								</span>
							)}
							{tags.map((tag, index) => (
								<span class="pill">
									<span data-locale="zh">{tag}</span>
									<span data-locale="en">{postText[entryId]?.tags?.[index] ?? tag}</span>
								</span>
							))}
						</div>
					</div>
					<div class:list={['hero-panel', 'surface', { empty: !heroImage }]}>
						{heroImage ? (
							<Image width={900} height={720} src={heroImage} alt="" />
						) : (
							<strong>{categoryLabels[category].en}</strong>
						)}
					</div>
				</header>

				<div class="post-grid">
					<aside class="reading-rail surface" aria-label="Reading metadata">
						<div class="rail-item">
							<strong>{readingMinutes}</strong>
							<span><span data-locale="zh">分钟阅读</span><span data-locale="en">min read</span></span>
						</div>
						<div class="rail-item">
							<strong>{tocHeadings.length}</strong>
							<span><span data-locale="zh">个小节</span><span data-locale="en">sections</span></span>
						</div>
						<div class="rail-item">
							<strong>{tags.length}</strong>
							<span><span data-locale="zh">个标签</span><span data-locale="en">tags</span></span>
						</div>
					</aside>

					<div class="article-prose surface" data-article-body>
						<slot />
					</div>

					<aside class="toc surface" aria-label="Table of contents">
						<h2><span data-locale="zh">目录</span><span data-locale="en">Contents</span></h2>
						{
							tocHeadings.length > 0 ? (
								<nav>
									{tocHeadings.map((heading) => (
										<a href={`#${heading.slug}`} data-toc-link data-depth={heading.depth}>
											{heading.text}
										</a>
									))}
								</nav>
							) : (
								<p class="toc-empty">
									<span data-locale="zh">这篇很短，不需要目录。</span>
									<span data-locale="en">This one is short enough without a table of contents.</span>
								</p>
							)
						}
					</aside>
				</div>
			</article>
		</main>
		<Footer />

		<script>
			const progress = document.querySelector('#readingProgress');
			const body = document.querySelector('[data-article-body]');
			const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));

			const updateProgress = () => {
				if (!progress || !body) return;
				const rect = body.getBoundingClientRect();
				const total = rect.height - window.innerHeight + 120;
				const read = -rect.top + 80;
				const ratio = Math.max(0, Math.min(1, total <= 0 ? 1 : read / total));
				progress.style.transform = `scaleX(${ratio})`;
			};

			window.addEventListener('scroll', updateProgress, { passive: true });
			window.addEventListener('resize', updateProgress);
			updateProgress();

			if ('IntersectionObserver' in window && tocLinks.length > 0) {
				const linksById = new Map(
					tocLinks.map((link) => [link.getAttribute('href')?.slice(1), link]),
				);
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							tocLinks.forEach((link) => link.classList.remove('is-active'));
							linksById.get(entry.target.id)?.classList.add('is-active');
						});
					},
					{ rootMargin: '-18% 0px -70% 0px', threshold: 0.01 },
				);

				linksById.forEach((_, id) => {
					const heading = document.getElementById(id ?? '');
					if (heading) observer.observe(heading);
				});
			}
		</script>
	</body>
</html>
