---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 | ${SITE_TITLE}`} description="About this personal note garden." />
		<style>
			.about-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(280px, 0.46fr);
				gap: 1rem;
				align-items: start;
			}

			.about-hero,
			.about-side,
			.now-card,
			.route-card,
			.stack-card {
				padding: clamp(1.2rem, 3vw, 2rem);
			}

			.about-hero {
				min-height: 560px;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				overflow: hidden;
				background:
					linear-gradient(145deg, var(--panel-strong), color-mix(in srgb, var(--paper-deep) 34%, transparent)),
					var(--panel);
			}

			.about-hero h1 {
				max-width: 9ch;
			}

			.about-hero p {
				max-width: 760px;
				color: var(--ink-soft);
				font-size: clamp(1.05rem, 2vw, 1.28rem);
			}

			.identity-board {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.75rem;
				margin-top: 2rem;
			}

			.identity-item {
				min-height: 9rem;
				padding: 0.95rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel);
			}

			.identity-item strong {
				display: block;
				margin-bottom: 0.4rem;
				font-size: 1.25rem;
			}

			.identity-item span {
				color: var(--muted);
				font-size: 0.88rem;
				line-height: 1.38;
			}

			.about-side {
				display: grid;
				gap: 1rem;
				background: var(--inverse);
				color: var(--inverse-text);
			}

			.about-side h2 {
				color: var(--inverse-text);
				font-size: clamp(2rem, 4vw, 3.6rem);
			}

			.about-side p,
			.about-side li {
				color: var(--inverse-muted);
			}

			.now-list,
			.route-list {
				display: grid;
				gap: 0.75rem;
				margin: 1rem 0 0;
				padding: 0;
				list-style: none;
			}

			.now-list li,
			.route-list li {
				padding: 0.85rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: color-mix(in srgb, var(--panel) 74%, transparent);
			}

			.lower-grid {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: minmax(0, 0.68fr) minmax(280px, 0.32fr);
				gap: 1rem;
			}

			.route-list li {
				display: grid;
				grid-template-columns: 2.8rem minmax(0, 1fr);
				gap: 0.8rem;
				align-items: start;
			}

			.route-number {
				display: inline-grid;
				place-items: center;
				width: 2.4rem;
				height: 2.4rem;
				border-radius: 999px;
				background: var(--ink);
				color: var(--inverse-text);
				font-weight: 700;
			}

			.route-list strong {
				display: block;
				margin-bottom: 0.2rem;
			}

			.route-list span {
				color: var(--muted);
				font-size: 0.9rem;
			}

			.stack-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 1rem;
			}

			.stack-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			@media (max-width: 900px) {
				.about-grid,
				.lower-grid {
					grid-template-columns: 1fr;
				}

				.identity-board {
					grid-template-columns: 1fr;
				}

				.about-hero {
					min-height: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="about-grid">
			<section class="about-hero surface">
				<div>
					<div class="eyebrow">About</div>
					<h1><span data-locale="zh">关于 GGGengXXX</span><span data-locale="en">About GGGengXXX</span></h1>
					<p>
						<span data-locale="zh">我在这里保存学习、研究、写代码和生活里的小型证据。这个博客更像一张桌子：有些东西是整理好的文章，有些只是先放下的纸条。</span>
						<span data-locale="en">I keep small pieces of evidence from learning, research, coding, and ordinary life here. This blog is more like a desk: some things are polished essays, some are notes waiting to be sorted.</span>
					</p>
				</div>
				<div class="identity-board" aria-label="Identity">
					<div class="identity-item">
						<strong><span data-locale="zh">写作方式</span><span data-locale="en">Writing</span></strong>
						<span data-locale="zh">先记录，再整理；先让问题留下来，再慢慢长出答案。</span>
						<span data-locale="en">Record first, organize later; let questions stay long enough to grow answers.</span>
					</div>
					<div class="identity-item">
						<strong><span data-locale="zh">关注方向</span><span data-locale="en">Focus</span></strong>
						<span data-locale="zh">AI、三维视觉、具身智能、论文阅读和个人知识管理。</span>
						<span data-locale="en">AI, 3D vision, embodied intelligence, paper reading, and personal knowledge systems.</span>
					</div>
					<div class="identity-item">
						<strong><span data-locale="zh">站点气质</span><span data-locale="en">Site mood</span></strong>
						<span data-locale="zh">好读、可探索、有一点藏起来的小玩具。</span>
						<span data-locale="en">Readable, explorable, with a few tucked-away toys.</span>
					</div>
				</div>
			</section>

			<aside class="about-side surface">
				<div>
					<div class="eyebrow">Now</div>
					<h2><span data-locale="zh">现在</span><span data-locale="en">Now</span></h2>
					<p>
						<span data-locale="zh">最近的重点是把博客从“能写”升级成“愿意常来写”。</span>
						<span data-locale="en">The current focus is turning the blog from something writable into somewhere worth returning to.</span>
					</p>
				</div>
				<ul class="now-list">
					<li><span data-locale="zh">整理论文阅读笔记</span><span data-locale="en">Organizing paper reading notes</span></li>
					<li><span data-locale="zh">把 MDX 变成互动文章入口</span><span data-locale="en">Turning MDX into a home for interactive writing</span></li>
					<li><span data-locale="zh">为个人站加入小型游戏页面</span><span data-locale="en">Adding a small game page to the personal site</span></li>
				</ul>
			</aside>

			<section class="lower-grid">
				<div class="route-card surface">
					<div class="eyebrow">Routes</div>
					<h2><span data-locale="zh">这个站点怎么逛</span><span data-locale="en">How to wander</span></h2>
					<ul class="route-list">
						<li>
							<span class="route-number">1</span>
							<div>
								<strong><span data-locale="zh">读文章</span><span data-locale="en">Read</span></strong>
								<span data-locale="zh">从归档进入技术笔记、日记和专题文章。</span>
								<span data-locale="en">Open the archive for technical notes, diary fragments, and essays.</span>
							</div>
						</li>
						<li>
							<span class="route-number">2</span>
							<div>
								<strong><span data-locale="zh">玩实验</span><span data-locale="en">Explore</span></strong>
								<span data-locale="zh">去实验室调参数，把抽象概念变成可观察的东西。</span>
								<span data-locale="en">Visit the lab and turn abstract ideas into adjustable things.</span>
							</div>
						</li>
						<li>
							<span class="route-number">3</span>
							<div>
								<strong><span data-locale="zh">开车逛站</span><span data-locale="en">Drive</span></strong>
								<span data-locale="zh">游戏页面会把博客入口藏进一个小地图。</span>
								<span data-locale="en">The game page hides site routes inside a small map.</span>
							</div>
						</li>
					</ul>
				</div>

				<div class="stack-card surface">
					<div>
						<div class="eyebrow">Stack</div>
						<h2><span data-locale="zh">技术栈</span><span data-locale="en">Stack</span></h2>
						<p>
							<span data-locale="zh">静态生成，适合部署在 GitHub Pages；写作继续用 Markdown 和 MDX。</span>
							<span data-locale="en">Static generation for GitHub Pages, with Markdown and MDX for writing.</span>
						</p>
					</div>
					<div class="stack-tags">
						<span class="pill">Astro</span>
						<span class="pill">MDX</span>
						<span class="pill">GitHub Pages</span>
						<span class="pill">RSS</span>
						<span class="pill">KaTeX</span>
					</div>
					<div class="tag-row">
						<a class="button-link secondary" href={`${base}/blog/`}>
							<span data-locale="zh">看归档</span>
							<span data-locale="en">Archive</span>
						</a>
						<a class="button-link secondary" href="https://github.com/GGGengXXX" target="_blank">GitHub</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
