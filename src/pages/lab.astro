---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`实验室 | ${SITE_TITLE}`} description="Today moon position, local sky, and weather lab." />
		<style>
			.lab-shell {
				display: grid;
				gap: 1rem;
			}

			.sky-lab {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(320px, 0.36fr);
				gap: 1rem;
				align-items: stretch;
			}

			.sky-stage {
				position: relative;
				min-height: 680px;
				overflow: hidden;
				background:
					radial-gradient(circle at 72% 12%, rgba(255, 210, 128, 0.18), transparent 28%),
					linear-gradient(155deg, #0e171d 0%, #162323 54%, #22271d 100%);
			}

			.sky-stage canvas {
				display: block;
				width: 100%;
				height: 100%;
				min-height: 680px;
				border-radius: var(--radius);
			}

			.sky-label {
				position: absolute;
				left: 1rem;
				top: 1rem;
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				color: #fff8e8;
				pointer-events: none;
			}

			.sky-label span {
				padding: 0.34rem 0.58rem;
				border: 1px solid rgba(255, 248, 232, 0.18);
				border-radius: 999px;
				background: rgba(255, 248, 232, 0.08);
				font-size: 0.78rem;
				font-weight: 700;
			}

			.lab-controls {
				display: grid;
				gap: 1rem;
				align-content: start;
				padding: clamp(1rem, 2.4vw, 1.35rem);
			}

			.readout-head {
				display: grid;
				gap: 0.55rem;
			}

			.readout-head h1 {
				margin: 0;
				font-size: clamp(2.2rem, 5vw, 4.7rem);
				line-height: 0.94;
				letter-spacing: 0;
			}

			.readout-head p {
				margin: 0;
				color: var(--muted);
				font-size: 0.98rem;
			}

			.status-pill {
				display: inline-flex;
				width: fit-content;
				align-items: center;
				gap: 0.42rem;
				padding: 0.36rem 0.58rem;
				border: 1px solid var(--line);
				border-radius: 999px;
				background: var(--panel);
				color: var(--muted);
				font-size: 0.8rem;
				font-weight: 700;
			}

			.status-dot {
				width: 0.48rem;
				height: 0.48rem;
				border-radius: 999px;
				background: var(--gold);
				box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold), transparent 78%);
			}

			.metric-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.65rem;
			}

			.metric {
				min-height: 6.1rem;
				padding: 0.82rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel);
			}

			.metric span {
				display: block;
				color: var(--muted);
				font-size: 0.78rem;
				font-weight: 700;
			}

			.metric strong {
				display: block;
				margin-top: 0.28rem;
				color: var(--ink);
				font-size: clamp(1.28rem, 3.4vw, 2.15rem);
				line-height: 1;
			}

			.metric small {
				display: block;
				margin-top: 0.42rem;
				color: var(--ink-soft);
				line-height: 1.28;
			}

			.control-card {
				display: grid;
				gap: 0.85rem;
				padding: 0.95rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel-strong);
			}

			.control-row {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.65rem;
			}

			.field {
				display: grid;
				gap: 0.35rem;
			}

			.field label {
				color: var(--muted);
				font-size: 0.78rem;
				font-weight: 700;
			}

			.field input {
				width: 100%;
				min-height: 2.65rem;
				padding: 0.55rem 0.65rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel);
				color: var(--ink);
				font: inherit;
			}

			.button-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.lab-button {
				min-height: 2.7rem;
				padding: 0.65rem 0.88rem;
				border: 1px solid var(--line);
				border-radius: 999px;
				background: var(--ink);
				color: var(--inverse-text);
				cursor: pointer;
				font-weight: 700;
			}

			.lab-button.secondary {
				background: var(--panel);
				color: var(--ink);
			}

			.lab-button:disabled {
				cursor: progress;
				opacity: 0.62;
			}

			.lab-button:hover:not(:disabled) {
				border-color: var(--red);
				color: #fff8e8;
				background: var(--red);
			}

			.locate-button {
				position: relative;
				isolation: isolate;
				width: 100%;
				min-height: 3.35rem;
				border-color: color-mix(in srgb, var(--red), var(--line) 20%);
				background:
					linear-gradient(135deg, color-mix(in srgb, var(--red), #ffffff 6%), var(--accent-dark));
				box-shadow:
					0 16px 32px color-mix(in srgb, var(--red), transparent 72%),
					inset 0 1px 0 rgba(255, 248, 232, 0.26);
			}

			.locate-button::after {
				content: '';
				position: absolute;
				inset: 0.34rem;
				z-index: -1;
				border: 1px solid rgba(255, 248, 232, 0.28);
				border-radius: inherit;
				opacity: 0.72;
			}

			.weather-strip {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.65rem;
			}

			.weather-tile {
				min-height: 5.3rem;
				padding: 0.75rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel);
			}

			.weather-tile span {
				display: block;
				color: var(--muted);
				font-size: 0.74rem;
				font-weight: 700;
			}

			.weather-tile strong {
				display: block;
				margin-top: 0.3rem;
				font-size: 1.08rem;
				line-height: 1.1;
			}

			.globe-card {
				display: grid;
				grid-template-columns: minmax(6.5rem, 0.72fr) minmax(0, 1fr);
				gap: 0.72rem;
				align-items: center;
				padding: 0.85rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background:
					radial-gradient(circle at 28% 20%, rgba(142, 208, 214, 0.18), transparent 34%),
					var(--panel);
			}

			.globe-card canvas {
				display: block;
				width: 100%;
				max-width: 8.75rem;
				aspect-ratio: 1;
				border-radius: 999px;
				justify-self: center;
				box-shadow: 0 14px 30px rgba(18, 64, 82, 0.18);
			}

			.globe-card .locate-button {
				grid-column: 1 / -1;
			}

			.globe-copy {
				display: grid;
				gap: 0.38rem;
			}

			.globe-copy span {
				color: var(--muted);
				font-size: 0.78rem;
				font-weight: 700;
			}

			.globe-copy strong {
				font-size: 1.28rem;
				line-height: 1;
			}

			.globe-copy small {
				color: var(--ink-soft);
				font-size: 0.82rem;
				line-height: 1.35;
			}

			.note-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
			}

			.note-card {
				padding: 1rem;
			}

			.note-card strong {
				display: block;
				margin-bottom: 0.35rem;
				font-size: 1.2rem;
			}

			.note-card span {
				color: var(--muted);
				font-size: 0.9rem;
			}

			@media (max-width: 980px) {
				.sky-lab,
				.note-grid {
					grid-template-columns: 1fr;
				}

				.sky-stage,
				.sky-stage canvas {
					min-height: 560px;
				}
			}

			@media (max-width: 560px) {
				.metric-grid,
				.control-row,
				.weather-strip,
				.globe-card {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="lab-shell">
			<section class="sky-lab">
				<div class="sky-stage surface">
					<canvas id="moonCanvas" width="1200" height="760" aria-label="Today moon sky map"></canvas>
					<div class="sky-label" aria-hidden="true">
						<span id="todayChip">Today</span>
						<span id="locationChip">Location pending</span>
						<span id="weatherChip">Weather pending</span>
					</div>
				</div>

				<aside class="lab-controls surface">
					<div class="readout-head">
						<div class="eyebrow">Moon Lab</div>
						<h1>
							<span data-locale="zh">今日月亮</span>
							<span data-locale="en">Today Moon</span>
						</h1>
						<p id="dateSummary">正在读取今天的日期...</p>
						<div class="status-pill">
							<span class="status-dot"></span>
							<span id="locationStatus">使用演示坐标，可点击获取当前位置</span>
						</div>
					</div>

					<div class="globe-card" aria-label="Location globe">
						<canvas id="globeCanvas" width="280" height="280"></canvas>
						<div class="globe-copy">
							<span>球形定位</span>
							<strong id="globeTitle">等待定位</strong>
							<small id="globeDetail">允许定位后，会在地球上标记当前位置，并把天气效果同步到全站。</small>
						</div>
						<button class="lab-button locate-button" type="button" id="locateButton">授权定位 · 获取当前位置和天气</button>
					</div>

					<div class="metric-grid" aria-label="Moon position metrics">
						<div class="metric">
							<span>方位 Azimuth</span>
							<strong id="azimuthValue">--</strong>
							<small id="directionValue">等待计算</small>
						</div>
						<div class="metric">
							<span>高度 Altitude</span>
							<strong id="altitudeValue">--</strong>
							<small id="visibilityValue">等待计算</small>
						</div>
						<div class="metric">
							<span>月相 Phase</span>
							<strong id="phaseValue">--</strong>
							<small id="illuminationValue">等待计算</small>
						</div>
						<div class="metric">
							<span>距离 Distance</span>
							<strong id="distanceValue">--</strong>
							<small id="ageValue">等待计算</small>
						</div>
					</div>

					<div class="control-card">
						<div class="button-row">
							<button class="lab-button secondary" type="button" id="nowButton">回到现在</button>
							<a class="lab-button secondary" href={`${base}/game/`}>去游戏页</a>
						</div>
						<div class="control-row">
							<div class="field">
								<label for="dateInput">日期</label>
								<input id="dateInput" type="date" />
							</div>
							<div class="field">
								<label for="timeInput">时间</label>
								<input id="timeInput" type="time" step="60" />
							</div>
						</div>
						<div class="control-row">
							<div class="field">
								<label for="latInput">纬度</label>
								<input id="latInput" type="number" step="0.0001" inputmode="decimal" />
							</div>
							<div class="field">
								<label for="lonInput">经度</label>
								<input id="lonInput" type="number" step="0.0001" inputmode="decimal" />
							</div>
						</div>
					</div>

					<div class="weather-strip" aria-label="Weather">
						<div class="weather-tile">
							<span>天气</span>
							<strong id="weatherCondition">待定位</strong>
						</div>
						<div class="weather-tile">
							<span>温度</span>
							<strong id="temperatureValue">--</strong>
						</div>
						<div class="weather-tile">
							<span>云量</span>
							<strong id="cloudValue">--</strong>
						</div>
					</div>

				</aside>
			</section>

			<section class="note-grid" aria-label="Experiment notes">
				<div class="note-card surface">
					<strong>今天</strong>
					<span>页面默认使用浏览器当天日期和当前时间，刷新后会自动更新。</span>
				</div>
				<div class="note-card surface">
					<strong>位置</strong>
					<span>线上 HTTPS 页面可调用浏览器定位；未授权时使用北京演示坐标。</span>
				</div>
				<div class="note-card surface">
					<strong>天气</strong>
					<span>定位成功后通过 Open-Meteo 获取实时温度、云量、风和湿度。</span>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const canvas = document.querySelector('#moonCanvas');
			const ctx = canvas?.getContext('2d');
			const globeCanvas = document.querySelector('#globeCanvas');
			const globeCtx = globeCanvas?.getContext('2d');
			const todayChip = document.querySelector('#todayChip');
			const locationChip = document.querySelector('#locationChip');
			const weatherChip = document.querySelector('#weatherChip');
			const dateSummary = document.querySelector('#dateSummary');
			const locationStatus = document.querySelector('#locationStatus');
			const dateInput = document.querySelector('#dateInput');
			const timeInput = document.querySelector('#timeInput');
			const latInput = document.querySelector('#latInput');
			const lonInput = document.querySelector('#lonInput');
			const locateButton = document.querySelector('#locateButton');
			const nowButton = document.querySelector('#nowButton');
			const azimuthValue = document.querySelector('#azimuthValue');
			const altitudeValue = document.querySelector('#altitudeValue');
			const directionValue = document.querySelector('#directionValue');
			const visibilityValue = document.querySelector('#visibilityValue');
			const phaseValue = document.querySelector('#phaseValue');
			const illuminationValue = document.querySelector('#illuminationValue');
			const distanceValue = document.querySelector('#distanceValue');
			const ageValue = document.querySelector('#ageValue');
			const weatherCondition = document.querySelector('#weatherCondition');
			const temperatureValue = document.querySelector('#temperatureValue');
			const cloudValue = document.querySelector('#cloudValue');
			const globeTitle = document.querySelector('#globeTitle');
			const globeDetail = document.querySelector('#globeDetail');
			const synodicMonth = 29.530588853;
			const weatherStorageKey = 'blog-weather-context';
			const fallbackLocation = {
				lat: 39.9042,
				lon: 116.4074,
				label: '北京演示坐标',
				source: 'fallback',
			};
			let activeLocation = { ...fallbackLocation };
			let weatherData = null;

			const rad = (degrees) => (degrees * Math.PI) / 180;
			const deg = (radians) => (radians * 180) / Math.PI;
			const normalizeDegrees = (value) => ((value % 360) + 360) % 360;
			const normalizeRadians = (value) => ((value % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);

			const weatherCodeText = {
				0: '晴朗',
				1: '大致晴朗',
				2: '局部多云',
				3: '阴天',
				45: '雾',
				48: '雾凇',
				51: '小毛毛雨',
				53: '毛毛雨',
				55: '较强毛毛雨',
				61: '小雨',
				63: '中雨',
				65: '大雨',
				71: '小雪',
				73: '中雪',
				75: '大雪',
				80: '阵雨',
				81: '较强阵雨',
				82: '强阵雨',
				95: '雷雨',
				96: '雷雨伴冰雹',
				99: '强雷雨伴冰雹',
			};

			const formatDateInput = (date) => {
				const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
				return local.toISOString().slice(0, 10);
			};

			const formatTimeInput = (date) => {
				return `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
			};

			const selectedDate = () => {
				const datePart = dateInput?.value || formatDateInput(new Date());
				const timePart = timeInput?.value || formatTimeInput(new Date());
				return new Date(`${datePart}T${timePart}:00`);
			};

			const julianDay = (date) => date.getTime() / 86400000 + 2440587.5;

			const sunPosition = (days) => {
				const meanAnomaly = rad(357.529 + 0.98560028 * days);
				const center = rad(1.915) * Math.sin(meanAnomaly) + rad(0.02) * Math.sin(2 * meanAnomaly);
				const longitude = normalizeRadians(rad(280.459 + 0.98564736 * days) + center);
				const obliquity = rad(23.439 - 0.00000036 * days);
				return {
					longitude,
					ra: Math.atan2(Math.cos(obliquity) * Math.sin(longitude), Math.cos(longitude)),
					dec: Math.asin(Math.sin(obliquity) * Math.sin(longitude)),
				};
			};

			const moonCoordinates = (days) => {
				const meanLongitude = rad(218.316 + 13.176396 * days);
				const meanAnomaly = rad(134.963 + 13.064993 * days);
				const argument = rad(93.272 + 13.22935 * days);
				const longitude = normalizeRadians(meanLongitude + rad(6.289) * Math.sin(meanAnomaly));
				const latitude = rad(5.128) * Math.sin(argument);
				const distance = 385001 - 20905 * Math.cos(meanAnomaly);
				const obliquity = rad(23.439 - 0.00000036 * days);
				return {
					longitude,
					latitude,
					distance,
					ra: Math.atan2(
						Math.sin(longitude) * Math.cos(obliquity) - Math.tan(latitude) * Math.sin(obliquity),
						Math.cos(longitude),
					),
					dec: Math.asin(
						Math.sin(latitude) * Math.cos(obliquity)
							+ Math.cos(latitude) * Math.sin(obliquity) * Math.sin(longitude),
					),
				};
			};

			const horizontalPosition = (date, latitude, longitude, rightAscension, declination) => {
				const days = julianDay(date) - 2451545;
				const localSidereal = rad(280.16 + 360.9856235 * days) + rad(longitude);
				const hourAngle = localSidereal - rightAscension;
				const phi = rad(latitude);
				const altitude = Math.asin(
					Math.sin(phi) * Math.sin(declination) + Math.cos(phi) * Math.cos(declination) * Math.cos(hourAngle),
				);
				const azimuth = Math.atan2(
					-Math.sin(hourAngle),
					Math.tan(declination) * Math.cos(phi) - Math.sin(phi) * Math.cos(hourAngle),
				);
				return {
					altitude: deg(altitude),
					azimuth: normalizeDegrees(deg(azimuth)),
				};
			};

			const phaseName = (age) => {
				if (age < 1.85 || age > 27.68) return '新月';
				if (age < 5.54) return '蛾眉月';
				if (age < 9.23) return '上弦月';
				if (age < 12.92) return '盈凸月';
				if (age < 16.61) return '满月';
				if (age < 20.3) return '亏凸月';
				if (age < 23.99) return '下弦月';
				return '残月';
			};

			const compassName = (azimuth) => {
				const labels = ['北', '东北', '东', '东南', '南', '西南', '西', '西北'];
				return labels[Math.round(azimuth / 45) % 8];
			};

			const moonState = () => {
				const date = selectedDate();
				const days = julianDay(date) - 2451545;
				const sun = sunPosition(days);
				const moon = moonCoordinates(days);
				const horizontal = horizontalPosition(date, activeLocation.lat, activeLocation.lon, moon.ra, moon.dec);
				const elongation = normalizeRadians(moon.longitude - sun.longitude);
				const age = (elongation / (Math.PI * 2)) * synodicMonth;
				const illumination = (1 - Math.cos(elongation)) / 2;
				return {
					date,
					...horizontal,
					age,
					illumination,
					distance: moon.distance,
					phase: phaseName(age),
					direction: compassName(horizontal.azimuth),
				};
			};

			const updateText = (state) => {
				const dateText = new Intl.DateTimeFormat('zh-CN', {
					weekday: 'long',
					year: 'numeric',
					month: 'long',
					day: 'numeric',
					hour: '2-digit',
					minute: '2-digit',
				}).format(state.date);
				if (todayChip) todayChip.textContent = formatDateInput(state.date);
				if (dateSummary) dateSummary.textContent = `当前计算时间：${dateText}`;
				if (locationChip) locationChip.textContent = `${activeLocation.label} ${activeLocation.lat.toFixed(2)}, ${activeLocation.lon.toFixed(2)}`;
				if (azimuthValue) azimuthValue.textContent = `${Math.round(state.azimuth)}°`;
				if (altitudeValue) altitudeValue.textContent = `${Math.round(state.altitude)}°`;
				if (directionValue) directionValue.textContent = `${state.direction}方向`;
				if (visibilityValue) visibilityValue.textContent = state.altitude >= 0 ? '月亮在地平线上方' : '月亮在地平线下方';
				if (phaseValue) phaseValue.textContent = state.phase;
				if (illuminationValue) illuminationValue.textContent = `亮面约 ${Math.round(state.illumination * 100)}%`;
				if (distanceValue) distanceValue.textContent = `${Math.round(state.distance / 1000)}万 km`;
				if (ageValue) ageValue.textContent = `月龄 ${state.age.toFixed(1)} 天`;
				if (locationStatus) {
					locationStatus.textContent = activeLocation.source === 'browser'
						? '已使用浏览器当前位置'
						: '未授权定位，使用北京演示坐标';
				}
			};

			const resizeCanvas = () => {
				if (!canvas || !ctx) return;
				const rect = canvas.getBoundingClientRect();
				const dpr = Math.min(2, window.devicePixelRatio || 1);
				canvas.width = Math.round(rect.width * dpr);
				canvas.height = Math.round(rect.height * dpr);
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			};

			const resizeGlobeCanvas = () => {
				if (!globeCanvas || !globeCtx) return;
				const rect = globeCanvas.getBoundingClientRect();
				const size = Math.round(rect.width || 220);
				const dpr = Math.min(2, window.devicePixelRatio || 1);
				globeCanvas.width = Math.round(size * dpr);
				globeCanvas.height = Math.round(size * dpr);
				globeCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
			};

			const projectedGlobePoint = (lat, lon, rotation, radius) => {
				const phi = rad(lat);
				const lambda = rad(lon) + rotation;
				return {
					x: radius * Math.cos(phi) * Math.sin(lambda),
					y: -radius * Math.sin(phi),
					z: radius * Math.cos(phi) * Math.cos(lambda),
				};
			};

			const drawGlobe = () => {
				if (!globeCanvas || !globeCtx) return;
				const width = globeCanvas.getBoundingClientRect().width || 260;
				const height = width;
				const cx = width / 2;
				const cy = height / 2;
				const radius = width * 0.43;
				const rotation = rad(-activeLocation.lon);
				globeCtx.clearRect(0, 0, width, height);

				const glow = globeCtx.createRadialGradient(cx - radius * 0.25, cy - radius * 0.28, radius * 0.08, cx, cy, radius * 1.28);
				glow.addColorStop(0, '#9bd3ee');
				glow.addColorStop(0.45, '#236d8f');
				glow.addColorStop(1, '#102c39');
				globeCtx.fillStyle = glow;
				globeCtx.beginPath();
				globeCtx.arc(cx, cy, radius, 0, Math.PI * 2);
				globeCtx.fill();

				globeCtx.save();
				globeCtx.beginPath();
				globeCtx.arc(cx, cy, radius, 0, Math.PI * 2);
				globeCtx.clip();
				globeCtx.strokeStyle = 'rgba(255, 248, 232, 0.28)';
				globeCtx.lineWidth = 1;

				for (let lat = -60; lat <= 60; lat += 30) {
					globeCtx.beginPath();
					for (let lon = -180; lon <= 180; lon += 4) {
						const point = projectedGlobePoint(lat, lon, rotation, radius);
						const x = cx + point.x;
						const y = cy + point.y;
						if (lon === -180) globeCtx.moveTo(x, y);
						else globeCtx.lineTo(x, y);
					}
					globeCtx.stroke();
				}

				for (let lon = -150; lon <= 180; lon += 30) {
					globeCtx.beginPath();
					for (let lat = -86; lat <= 86; lat += 3) {
						const point = projectedGlobePoint(lat, lon, rotation, radius);
						const x = cx + point.x;
						const y = cy + point.y;
						if (lat === -86) globeCtx.moveTo(x, y);
						else globeCtx.lineTo(x, y);
					}
					globeCtx.stroke();
				}

				const landColor = 'rgba(118, 147, 75, 0.72)';
				[
					{ lat: 35, lon: 100, rx: 42, ry: 24 },
					{ lat: 8, lon: 20, rx: 34, ry: 21 },
					{ lat: 48, lon: -100, rx: 38, ry: 22 },
					{ lat: -18, lon: -60, rx: 28, ry: 34 },
					{ lat: -25, lon: 135, rx: 28, ry: 16 },
				].forEach((land) => {
					const point = projectedGlobePoint(land.lat, land.lon, rotation, radius);
					if (point.z < -radius * 0.18) return;
					globeCtx.fillStyle = landColor;
					globeCtx.beginPath();
					globeCtx.ellipse(cx + point.x, cy + point.y, land.rx, land.ry, rad(land.lon / 4), 0, Math.PI * 2);
					globeCtx.fill();
				});

				const marker = projectedGlobePoint(activeLocation.lat, activeLocation.lon, rotation, radius);
				const markerVisible = marker.z > -radius * 0.08;
				if (markerVisible) {
					const mx = cx + marker.x;
					const my = cy + marker.y;
					globeCtx.strokeStyle = 'rgba(255, 248, 232, 0.82)';
					globeCtx.lineWidth = 2;
					globeCtx.beginPath();
					globeCtx.arc(mx, my, 15, 0, Math.PI * 2);
					globeCtx.stroke();
					globeCtx.fillStyle = '#c94338';
					globeCtx.beginPath();
					globeCtx.arc(mx, my, 5.4, 0, Math.PI * 2);
					globeCtx.fill();
				}
				globeCtx.restore();

				globeCtx.strokeStyle = 'rgba(255, 248, 232, 0.34)';
				globeCtx.lineWidth = 1.2;
				globeCtx.beginPath();
				globeCtx.arc(cx, cy, radius, 0, Math.PI * 2);
				globeCtx.stroke();

				if (globeTitle) globeTitle.textContent = activeLocation.source === 'browser' ? '已标记当前位置' : activeLocation.label;
				if (globeDetail) globeDetail.textContent = `${activeLocation.lat.toFixed(4)}°, ${activeLocation.lon.toFixed(4)}° · ${activeLocation.source === 'browser' ? '天气特效已同步到全站' : '点击授权按钮后可同步真实天气'}`;
			};

			const drawMoonDisk = (x, y, radius, age) => {
				if (!ctx) return;
				const phase = age / synodicMonth;
				const angle = phase * Math.PI * 2;
				const illumination = (1 - Math.cos(angle)) / 2;
				const waxing = phase <= 0.5;
				ctx.save();
				ctx.beginPath();
				ctx.arc(x, y, radius, 0, Math.PI * 2);
				ctx.clip();
				ctx.fillStyle = '#252a2f';
				ctx.fillRect(x - radius, y - radius, radius * 2, radius * 2);
				ctx.fillStyle = '#f2e6ce';
				if (illumination > 0.99) {
					ctx.beginPath();
					ctx.arc(x, y, radius, 0, Math.PI * 2);
					ctx.fill();
				} else if (illumination > 0.01) {
					if (illumination <= 0.5) {
						const rx = radius * (1 - illumination * 2);
						ctx.beginPath();
						if (waxing) {
							ctx.arc(x, y, radius, -Math.PI / 2, Math.PI / 2);
							ctx.ellipse(x, y, rx, radius, 0, Math.PI / 2, -Math.PI / 2, true);
						} else {
							ctx.arc(x, y, radius, Math.PI / 2, -Math.PI / 2);
							ctx.ellipse(x, y, rx, radius, 0, -Math.PI / 2, Math.PI / 2, true);
						}
						ctx.closePath();
						ctx.fill();
					} else {
						ctx.beginPath();
						ctx.arc(x, y, radius, 0, Math.PI * 2);
						ctx.fill();
						ctx.fillStyle = '#252a2f';
						const dark = 1 - illumination;
						const rx = radius * (1 - dark * 2);
						ctx.beginPath();
						if (waxing) {
							ctx.arc(x, y, radius, Math.PI / 2, -Math.PI / 2);
							ctx.ellipse(x, y, rx, radius, 0, -Math.PI / 2, Math.PI / 2, true);
						} else {
							ctx.arc(x, y, radius, -Math.PI / 2, Math.PI / 2);
							ctx.ellipse(x, y, rx, radius, 0, Math.PI / 2, -Math.PI / 2, true);
						}
						ctx.closePath();
						ctx.fill();
					}
				}
				const grd = ctx.createRadialGradient(x - radius * 0.32, y - radius * 0.34, radius * 0.08, x, y, radius);
				grd.addColorStop(0, 'rgba(255,255,255,0.24)');
				grd.addColorStop(1, 'rgba(0,0,0,0.34)');
				ctx.fillStyle = grd;
				ctx.beginPath();
				ctx.arc(x, y, radius, 0, Math.PI * 2);
				ctx.fill();
				ctx.restore();
			};

			const draw = () => {
				if (!canvas || !ctx) return;
				const state = moonState();
				updateText(state);
				const width = canvas.getBoundingClientRect().width;
				const height = canvas.getBoundingClientRect().height;
				ctx.clearRect(0, 0, width, height);

				const sky = ctx.createLinearGradient(0, 0, 0, height);
				sky.addColorStop(0, '#101926');
				sky.addColorStop(0.58, '#182628');
				sky.addColorStop(1, '#26331f');
				ctx.fillStyle = sky;
				ctx.fillRect(0, 0, width, height);

				for (let i = 0; i < 110; i += 1) {
					const x = seededStar(i, 13) * width;
					const y = seededStar(i, 71) * height * 0.72;
					const opacity = 0.14 + seededStar(i, 97) * 0.52;
					ctx.fillStyle = `rgba(255, 248, 232, ${opacity})`;
					ctx.beginPath();
					ctx.arc(x, y, 0.7 + seededStar(i, 131) * 1.2, 0, Math.PI * 2);
					ctx.fill();
				}

				const domeRadius = Math.min(width, height) * 0.33;
				const domeX = width * 0.43;
				const domeY = height * 0.55;
				ctx.save();
				ctx.translate(domeX, domeY);
				ctx.strokeStyle = 'rgba(255,248,232,0.22)';
				ctx.lineWidth = 1.4;
				[1, 0.66, 0.33].forEach((scale) => {
					ctx.beginPath();
					ctx.arc(0, 0, domeRadius * scale, 0, Math.PI * 2);
					ctx.stroke();
				});
				ctx.fillStyle = 'rgba(255,248,232,0.76)';
				ctx.font = '700 14px Atkinson, sans-serif';
				[
					['N', 0, -1],
					['E', 1, 0],
					['S', 0, 1],
					['W', -1, 0],
				].forEach(([label, x, y]) => {
					ctx.fillText(label, x * (domeRadius + 18) - 6, y * (domeRadius + 18) + 5);
				});
				const altitudeClamped = Math.max(-12, Math.min(90, state.altitude));
				const radius = domeRadius * (1 - Math.max(0, altitudeClamped) / 90);
				const az = rad(state.azimuth - 90);
				const moonX = Math.cos(az) * radius;
				const moonY = Math.sin(az) * radius;
				ctx.strokeStyle = 'rgba(141, 208, 214, 0.7)';
				ctx.beginPath();
				ctx.moveTo(0, 0);
				ctx.lineTo(moonX, moonY);
				ctx.stroke();
				ctx.fillStyle = state.altitude >= 0 ? '#8ed0d6' : 'rgba(142,208,214,0.34)';
				ctx.beginPath();
				ctx.arc(moonX, moonY, 8, 0, Math.PI * 2);
				ctx.fill();
				ctx.restore();

				const bigX = width * 0.78;
				const bigY = height * 0.42;
				const bigR = Math.min(width, height) * 0.13;
				drawMoonDisk(bigX, bigY, bigR, state.age);
				ctx.fillStyle = '#fff8e8';
				ctx.font = '700 26px Atkinson, sans-serif';
				ctx.fillText(state.phase, bigX - bigR, bigY + bigR + 42);
				ctx.fillStyle = 'rgba(255,248,232,0.62)';
				ctx.font = '400 15px Atkinson, sans-serif';
				ctx.fillText(`alt ${state.altitude.toFixed(1)} deg  az ${state.azimuth.toFixed(1)} deg`, bigX - bigR, bigY + bigR + 68);

				ctx.fillStyle = 'rgba(255,248,232,0.08)';
				ctx.fillRect(0, height * 0.78, width, height * 0.22);
				ctx.strokeStyle = 'rgba(255,248,232,0.28)';
				ctx.beginPath();
				ctx.moveTo(0, height * 0.78);
				ctx.lineTo(width, height * 0.78);
				ctx.stroke();
			};

			const seededStar = (index, salt) => {
				const value = Math.sin(index * 127.1 + salt * 311.7) * 43758.5453;
				return value - Math.floor(value);
			};

			const updateWeatherText = () => {
				if (!weatherData?.current) {
					if (weatherChip) weatherChip.textContent = 'Weather pending';
					return;
				}
				const current = weatherData.current;
				const units = weatherData.current_units ?? {};
				const condition = weatherCodeText[current.weather_code] ?? '天气已获取';
				if (weatherCondition) weatherCondition.textContent = condition;
				if (temperatureValue) temperatureValue.textContent = `${Math.round(current.temperature_2m)}${units.temperature_2m ?? '°C'}`;
				if (cloudValue) cloudValue.textContent = `${current.cloud_cover ?? '--'}%`;
				if (weatherChip) weatherChip.textContent = `${condition} · 风 ${current.wind_speed_10m ?? '--'}${units.wind_speed_10m ?? 'km/h'}`;
			};

			const publishWeatherContext = () => {
				if (!weatherData?.current) return;
				const context = {
					location: activeLocation,
					current: weatherData.current,
					current_units: weatherData.current_units ?? {},
					updatedAt: new Date().toISOString(),
				};
				localStorage.setItem(weatherStorageKey, JSON.stringify(context));
				window.dispatchEvent(new CustomEvent('blog-weather-updated', { detail: context }));
			};

			const fetchWeather = async () => {
				if (!Number.isFinite(activeLocation.lat) || !Number.isFinite(activeLocation.lon)) return;
				if (weatherChip) weatherChip.textContent = 'Fetching weather...';
				const url = new URL('https://api.open-meteo.com/v1/forecast');
				url.searchParams.set('latitude', activeLocation.lat.toFixed(4));
				url.searchParams.set('longitude', activeLocation.lon.toFixed(4));
				url.searchParams.set('current', 'temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,cloud_cover,wind_speed_10m');
				url.searchParams.set('timezone', 'auto');
				const response = await fetch(url);
				if (!response.ok) throw new Error(`Weather request failed: ${response.status}`);
				weatherData = await response.json();
				updateWeatherText();
				publishWeatherContext();
			};

			const applyLocation = (location) => {
				activeLocation = location;
				if (latInput) latInput.value = location.lat.toFixed(4);
				if (lonInput) lonInput.value = location.lon.toFixed(4);
				drawGlobe();
				draw();
			};

			const requestLocation = () => {
				if (!navigator.geolocation) {
					if (locationStatus) locationStatus.textContent = '当前浏览器不支持定位，继续使用演示坐标';
					return;
				}
				if (!window.isSecureContext && !['localhost', '127.0.0.1'].includes(window.location.hostname)) {
					if (locationStatus) locationStatus.textContent = '浏览器定位需要 HTTPS 页面';
					return;
				}
				if (locateButton) locateButton.disabled = true;
				if (locationStatus) locationStatus.textContent = '正在请求浏览器定位...';
				navigator.geolocation.getCurrentPosition(
					async (position) => {
						applyLocation({
							lat: position.coords.latitude,
							lon: position.coords.longitude,
							label: '当前位置',
							source: 'browser',
						});
						try {
							await fetchWeather();
						} catch (error) {
							if (weatherChip) weatherChip.textContent = '天气获取失败';
							if (weatherCondition) weatherCondition.textContent = '天气获取失败';
						} finally {
							if (locateButton) locateButton.disabled = false;
						}
					},
					() => {
						if (locationStatus) locationStatus.textContent = '定位未授权，继续使用北京演示坐标';
						if (locateButton) locateButton.disabled = false;
						draw();
					},
					{ enableHighAccuracy: false, timeout: 9000, maximumAge: 600000 },
				);
			};

			const setNow = () => {
				const now = new Date();
				if (dateInput) dateInput.value = formatDateInput(now);
				if (timeInput) timeInput.value = formatTimeInput(now);
				draw();
			};

			const setup = () => {
				setNow();
				applyLocation(fallbackLocation);
				updateWeatherText();
				resizeCanvas();
				resizeGlobeCanvas();
				drawGlobe();
				draw();
			};

			dateInput?.addEventListener('input', draw);
			timeInput?.addEventListener('input', draw);
			latInput?.addEventListener('input', () => {
				const next = Number(latInput.value);
				if (!Number.isFinite(next)) return;
				activeLocation = { ...activeLocation, lat: next, label: '手动坐标', source: 'manual' };
				drawGlobe();
				draw();
			});
			lonInput?.addEventListener('input', () => {
				const next = Number(lonInput.value);
				if (!Number.isFinite(next)) return;
				activeLocation = { ...activeLocation, lon: next, label: '手动坐标', source: 'manual' };
				drawGlobe();
				draw();
			});
			locateButton?.addEventListener('click', requestLocation);
			nowButton?.addEventListener('click', setNow);
			window.addEventListener('resize', () => {
				resizeCanvas();
				resizeGlobeCanvas();
				drawGlobe();
				draw();
			});

			setup();
			window.__moonLabDebug = () => ({
				location: activeLocation,
				weatherLoaded: Boolean(weatherData),
				state: moonState(),
			});
		</script>
	</body>
</html>
