---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`实验室 | ${SITE_TITLE}`} description="Interactive experiments for notes and essays." />
		<style>
			.lab-shell {
				display: grid;
				gap: 1rem;
			}

			.lab-hero {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(260px, 0.34fr);
				gap: 1rem;
				align-items: stretch;
			}

			.lab-title,
			.lab-note {
				padding: clamp(1.25rem, 3vw, 2rem);
			}

			.lab-title p {
				max-width: 760px;
				color: var(--ink-soft);
				font-size: clamp(1.04rem, 2vw, 1.24rem);
			}

			.lab-note {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				background: var(--inverse);
				color: var(--inverse-text);
			}

			.lab-note p {
				color: var(--inverse-muted);
			}

			.lab-note a {
				color: var(--inverse-text);
			}

			.lab-note .button-link.secondary {
				color: var(--ink);
			}

			.moon-lab {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(280px, 0.34fr);
				gap: 1rem;
				align-items: stretch;
			}

			.stage {
				position: relative;
				min-height: 620px;
				overflow: hidden;
				background:
					linear-gradient(145deg, rgba(12, 16, 21, 0.96), rgba(28, 29, 24, 0.96)),
					#101215;
			}

			.stage canvas {
				display: block;
				width: 100%;
				height: 100%;
				min-height: 620px;
				border-radius: var(--radius);
			}

			.stage-label {
				position: absolute;
				left: 1rem;
				top: 1rem;
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				color: #fff8e8;
				pointer-events: none;
			}

			.stage-label span {
				padding: 0.35rem 0.6rem;
				border: 1px solid rgba(255, 248, 232, 0.18);
				border-radius: 999px;
				background: rgba(255, 248, 232, 0.08);
				font-size: 0.8rem;
				font-weight: 700;
			}

			.lab-controls {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 1rem;
				padding: clamp(1rem, 3vw, 1.5rem);
			}

			.phase-readout strong {
				display: block;
				margin: 0.2rem 0 0.7rem;
				font-size: clamp(2rem, 5vw, 4rem);
				line-height: 0.98;
			}

			.phase-readout p {
				color: var(--muted);
			}

			.control-group {
				display: grid;
				gap: 0.7rem;
				padding: 0.95rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel);
			}

			.control-top {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				color: var(--muted);
				font-size: 0.85rem;
			}

			input[type='range'] {
				width: 100%;
				accent-color: var(--red);
			}

			.button-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.lab-button {
				min-height: 2.65rem;
				padding: 0.65rem 0.9rem;
				border: 1px solid var(--line);
				border-radius: 999px;
				background: var(--ink);
				color: var(--inverse-text);
				cursor: pointer;
				font-weight: 700;
			}

			.lab-button.secondary {
				background: var(--panel-strong);
				color: var(--ink);
			}

			.lab-button:hover {
				border-color: var(--red);
				color: #fff8e8;
				background: var(--red);
			}

			.note-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
			}

			.note-card {
				padding: 1rem;
			}

			.note-card strong {
				display: block;
				margin-bottom: 0.35rem;
				font-size: 1.2rem;
			}

			.note-card span {
				color: var(--muted);
				font-size: 0.9rem;
			}

			@media (max-width: 960px) {
				.lab-hero,
				.moon-lab,
				.note-grid {
					grid-template-columns: 1fr;
				}

				.stage,
				.stage canvas {
					min-height: 520px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="lab-shell">
			<section class="lab-hero">
				<div class="lab-title surface">
					<div class="eyebrow">Interactive Lab</div>
					<h1><span data-locale="zh">实验室</span><span data-locale="en">Lab</span></h1>
					<p>
						<span data-locale="zh">这里放文章里可以被拖动、观察和反复试的小模型。第一件样品是月相：拖动时间，看看太阳、地球、月亮和我们看到的亮面如何一起变化。</span>
						<span data-locale="en">This is where notes become draggable, observable, repeatable models. The first specimen is the Moon: move time and watch the Sun, Earth, Moon, and visible phase change together.</span>
					</p>
				</div>
				<aside class="lab-note surface">
					<div>
						<div class="eyebrow">Pattern</div>
						<p>
							<span data-locale="zh">以后论文阅读、几何直觉、训练流程都可以复用这个模式。</span>
							<span data-locale="en">Paper notes, geometry intuitions, and training flows can reuse this pattern later.</span>
						</p>
					</div>
					<a class="button-link secondary" href={`${base}/blog/using-mdx/`}>
						<span data-locale="zh">看 MDX 示例</span>
						<span data-locale="en">Open MDX note</span>
					</a>
				</aside>
			</section>

			<section class="moon-lab">
				<div class="stage surface">
					<canvas id="moonCanvas" width="1200" height="720" aria-label="Moon phase simulator"></canvas>
					<div class="stage-label" aria-hidden="true">
						<span>Sunlight →</span>
						<span>Orbit 29.5 days</span>
						<span>Drag the dial</span>
					</div>
				</div>

				<aside class="lab-controls surface">
					<div class="phase-readout">
						<div class="eyebrow">Moon Phase</div>
						<strong id="phaseName">
							<span data-locale="zh">上弦月</span>
							<span data-locale="en">First Quarter</span>
						</strong>
						<p id="phaseDescription">
							<span data-locale="zh">月亮绕到地球侧面，我们大约看到一半被太阳照亮的月面。</span>
							<span data-locale="en">The Moon sits to the side of Earth, so we see about half of its sunlit face.</span>
						</p>
					</div>

					<div class="control-group">
						<div class="control-top">
							<label for="daySlider">
								<span data-locale="zh">月龄</span>
								<span data-locale="en">Lunar day</span>
							</label>
							<span id="dayValue">7.4</span>
						</div>
						<input id="daySlider" type="range" min="0" max="29.53" step="0.01" value="7.38" />
					</div>

					<div class="control-group">
						<div class="control-top">
							<label for="tiltSlider">
								<span data-locale="zh">轨道倾角</span>
								<span data-locale="en">Orbit tilt</span>
							</label>
							<span id="tiltValue">12°</span>
						</div>
						<input id="tiltSlider" type="range" min="-28" max="28" step="1" value="12" />
					</div>

					<div class="button-row">
						<button class="lab-button" type="button" id="playButton">
							<span data-locale="zh">播放</span>
							<span data-locale="en">Play</span>
						</button>
						<button class="lab-button secondary" type="button" id="resetButton">
							<span data-locale="zh">回到上弦</span>
							<span data-locale="en">First quarter</span>
						</button>
						<a class="lab-button secondary" href={`${base}/game/`}>
							<span data-locale="zh">去游戏页</span>
							<span data-locale="en">Game page</span>
						</a>
					</div>
				</aside>
			</section>

			<section class="note-grid" aria-label="Experiment notes">
				<div class="note-card surface">
					<strong><span data-locale="zh">拖动</span><span data-locale="en">Drag</span></strong>
					<span data-locale="zh">小组件应该允许读者主动改变变量。</span>
					<span data-locale="en">A component should let readers change a variable directly.</span>
				</div>
				<div class="note-card surface">
					<strong><span data-locale="zh">观察</span><span data-locale="en">Observe</span></strong>
					<span data-locale="zh">画面要把变化结果立即反馈出来。</span>
					<span data-locale="en">The scene should answer the reader immediately.</span>
				</div>
				<div class="note-card surface">
					<strong><span data-locale="zh">写下来</span><span data-locale="en">Write</span></strong>
					<span data-locale="zh">互动不是装饰，它应该服务于一段解释。</span>
					<span data-locale="en">The interaction is not decoration; it should serve an explanation.</span>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const canvas = document.querySelector('#moonCanvas');
			const ctx = canvas?.getContext('2d');
			const daySlider = document.querySelector('#daySlider');
			const tiltSlider = document.querySelector('#tiltSlider');
			const dayValue = document.querySelector('#dayValue');
			const tiltValue = document.querySelector('#tiltValue');
			const phaseName = document.querySelector('#phaseName');
			const phaseDescription = document.querySelector('#phaseDescription');
			const playButton = document.querySelector('#playButton');
			const resetButton = document.querySelector('#resetButton');
			const cycle = 29.53;
			let isPlaying = false;
			let frame = 0;
			let last = performance.now();

			const phaseCopy = [
				{
					limit: 1.85,
					zh: '新月',
					en: 'New Moon',
					descriptionZh: '月亮在太阳方向附近，朝向我们的这一面几乎没有被照亮。',
					descriptionEn: 'The Moon sits near the Sun, and the side facing us is mostly unlit.',
				},
				{
					limit: 5.54,
					zh: '蛾眉月',
					en: 'Waxing Crescent',
					descriptionZh: '亮面开始从边缘长出来，月亮正在走向上弦。',
					descriptionEn: 'A bright edge starts to grow as the Moon moves toward first quarter.',
				},
				{
					limit: 9.23,
					zh: '上弦月',
					en: 'First Quarter',
					descriptionZh: '月亮绕到地球侧面，我们大约看到一半被太阳照亮的月面。',
					descriptionEn: 'The Moon sits to the side of Earth, so we see about half of its sunlit face.',
				},
				{
					limit: 12.92,
					zh: '盈凸月',
					en: 'Waxing Gibbous',
					descriptionZh: '亮面超过一半，月亮继续向满月靠近。',
					descriptionEn: 'More than half of the disk is bright as the Moon approaches full.',
				},
				{
					limit: 16.61,
					zh: '满月',
					en: 'Full Moon',
					descriptionZh: '地球位于太阳和月亮之间，我们看到几乎完整的受光面。',
					descriptionEn: 'Earth is between the Sun and Moon, so we see nearly the whole lit face.',
				},
				{
					limit: 20.3,
					zh: '亏凸月',
					en: 'Waning Gibbous',
					descriptionZh: '满月之后亮面开始收回，阴影从另一侧靠近。',
					descriptionEn: 'After full moon, the bright face starts to retreat from the other side.',
				},
				{
					limit: 23.99,
					zh: '下弦月',
					en: 'Last Quarter',
					descriptionZh: '再次看到大约一半月面，只是亮的一边换了方向。',
					descriptionEn: 'We see about half the disk again, but the bright side has switched.',
				},
				{
					limit: 27.68,
					zh: '残月',
					en: 'Waning Crescent',
					descriptionZh: '亮面越来越窄，月亮将回到新月。',
					descriptionEn: 'The bright sliver narrows as the Moon returns to new.',
				},
				{
					limit: cycle,
					zh: '新月',
					en: 'New Moon',
					descriptionZh: '一个周期结束，下一轮月相从这里重新开始。',
					descriptionEn: 'One cycle ends, and the next set of phases begins here.',
				},
			];

			const setCopy = (day) => {
				const copy = phaseCopy.find((item) => day <= item.limit) ?? phaseCopy[0];
				if (phaseName) {
					const zh = phaseName.querySelector('[data-locale="zh"]');
					const en = phaseName.querySelector('[data-locale="en"]');
					if (zh) zh.textContent = copy.zh;
					if (en) en.textContent = copy.en;
				}
				if (phaseDescription) {
					const zh = phaseDescription.querySelector('[data-locale="zh"]');
					const en = phaseDescription.querySelector('[data-locale="en"]');
					if (zh) zh.textContent = copy.descriptionZh;
					if (en) en.textContent = copy.descriptionEn;
				}
			};

			const resizeCanvas = () => {
				if (!canvas || !ctx) return;
				const rect = canvas.getBoundingClientRect();
				const dpr = Math.min(2, window.devicePixelRatio || 1);
				canvas.width = Math.round(rect.width * dpr);
				canvas.height = Math.round(rect.height * dpr);
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			};

			const drawMoonDisk = (x, y, radius, phase) => {
				if (!ctx) return;
				const angle = phase * Math.PI * 2;
				const illum = (1 - Math.cos(angle)) / 2;
				const waxing = phase <= 0.5;
				ctx.save();
				ctx.beginPath();
				ctx.arc(x, y, radius, 0, Math.PI * 2);
				ctx.clip();
				ctx.fillStyle = '#252a2f';
				ctx.fillRect(x - radius, y - radius, radius * 2, radius * 2);
				ctx.fillStyle = '#efe5cf';

				if (illum < 0.01) {
					ctx.restore();
					return;
				}
				if (illum > 0.99) {
					ctx.beginPath();
					ctx.arc(x, y, radius, 0, Math.PI * 2);
					ctx.fill();
					ctx.restore();
					return;
				}

				if (illum <= 0.5) {
					const rx = radius * (1 - illum * 2);
					ctx.beginPath();
					if (waxing) {
						ctx.arc(x, y, radius, -Math.PI / 2, Math.PI / 2);
						ctx.ellipse(x, y, rx, radius, 0, Math.PI / 2, -Math.PI / 2, true);
					} else {
						ctx.arc(x, y, radius, Math.PI / 2, -Math.PI / 2);
						ctx.ellipse(x, y, rx, radius, 0, -Math.PI / 2, Math.PI / 2, true);
					}
					ctx.closePath();
					ctx.fill();
				} else {
					ctx.beginPath();
					ctx.arc(x, y, radius, 0, Math.PI * 2);
					ctx.fill();
					ctx.fillStyle = '#252a2f';
					const dark = 1 - illum;
					const rx = radius * (1 - dark * 2);
					ctx.beginPath();
					if (waxing) {
						ctx.arc(x, y, radius, Math.PI / 2, -Math.PI / 2);
						ctx.ellipse(x, y, rx, radius, 0, -Math.PI / 2, Math.PI / 2, true);
					} else {
						ctx.arc(x, y, radius, -Math.PI / 2, Math.PI / 2);
						ctx.ellipse(x, y, rx, radius, 0, Math.PI / 2, -Math.PI / 2, true);
					}
					ctx.closePath();
					ctx.fill();
				}

				const grd = ctx.createRadialGradient(x - radius * 0.32, y - radius * 0.34, radius * 0.1, x, y, radius);
				grd.addColorStop(0, 'rgba(255,255,255,0.2)');
				grd.addColorStop(1, 'rgba(0,0,0,0.32)');
				ctx.fillStyle = grd;
				ctx.beginPath();
				ctx.arc(x, y, radius, 0, Math.PI * 2);
				ctx.fill();
				ctx.restore();
			};

			const draw = () => {
				if (!canvas || !ctx || !daySlider || !tiltSlider) return;
				const width = canvas.getBoundingClientRect().width;
				const height = canvas.getBoundingClientRect().height;
				const day = Number(daySlider.value);
				const tilt = Number(tiltSlider.value);
				const phase = day / cycle;
				const angle = phase * Math.PI * 2 - Math.PI;
				const orbitRadius = Math.min(width, height) * 0.25;
				const cx = width * 0.58;
				const cy = height * 0.5;
				const tiltY = Math.sin((tilt * Math.PI) / 180) * orbitRadius * 0.4;
				const moonX = cx + Math.cos(angle) * orbitRadius;
				const moonY = cy + Math.sin(angle) * orbitRadius * 0.58 + tiltY;
				const bigX = width * 0.23;
				const bigY = height * 0.52;
				const bigR = Math.min(width, height) * 0.17;

				ctx.clearRect(0, 0, width, height);
				ctx.fillStyle = '#101215';
				ctx.fillRect(0, 0, width, height);

				ctx.save();
				ctx.globalAlpha = 0.38;
				ctx.strokeStyle = 'rgba(255,248,232,0.08)';
				for (let x = 0; x < width; x += 36) {
					ctx.beginPath();
					ctx.moveTo(x, 0);
					ctx.lineTo(x, height);
					ctx.stroke();
				}
				for (let y = 0; y < height; y += 36) {
					ctx.beginPath();
					ctx.moveTo(0, y);
					ctx.lineTo(width, y);
					ctx.stroke();
				}
				ctx.restore();

				ctx.fillStyle = 'rgba(246,189,96,0.16)';
				ctx.fillRect(width - 150, 0, 150, height);
				const sunGradient = ctx.createRadialGradient(width - 64, cy, 8, width - 64, cy, 96);
				sunGradient.addColorStop(0, '#ffe2a8');
				sunGradient.addColorStop(1, 'rgba(246,189,96,0)');
				ctx.fillStyle = sunGradient;
				ctx.beginPath();
				ctx.arc(width - 64, cy, 96, 0, Math.PI * 2);
				ctx.fill();

				ctx.strokeStyle = 'rgba(255,248,232,0.28)';
				ctx.setLineDash([8, 10]);
				ctx.beginPath();
				ctx.ellipse(cx, cy + tiltY, orbitRadius, orbitRadius * 0.58, 0, 0, Math.PI * 2);
				ctx.stroke();
				ctx.setLineDash([]);

				const earthGradient = ctx.createRadialGradient(cx - 10, cy - 12, 8, cx, cy, 46);
				earthGradient.addColorStop(0, '#9bd3ee');
				earthGradient.addColorStop(0.55, '#236d8f');
				earthGradient.addColorStop(1, '#102c39');
				ctx.fillStyle = earthGradient;
				ctx.beginPath();
				ctx.arc(cx, cy, 42, 0, Math.PI * 2);
				ctx.fill();

				ctx.strokeStyle = 'rgba(255,226,168,0.35)';
				ctx.beginPath();
				ctx.moveTo(width - 144, cy);
				ctx.lineTo(cx, cy);
				ctx.stroke();

				drawMoonDisk(moonX, moonY, 24, phase);
				ctx.strokeStyle = 'rgba(255,248,232,0.22)';
				ctx.beginPath();
				ctx.moveTo(cx, cy);
				ctx.lineTo(moonX, moonY);
				ctx.stroke();

				drawMoonDisk(bigX, bigY, bigR, phase);
				ctx.fillStyle = '#fff8e8';
				ctx.font = '700 14px Atkinson, sans-serif';
				ctx.fillText(`day ${day.toFixed(1)}`, bigX - bigR, bigY + bigR + 34);
				ctx.fillStyle = 'rgba(255,248,232,0.62)';
				ctx.font = '400 13px Atkinson, sans-serif';
				ctx.fillText('visible phase from Earth', bigX - bigR, bigY + bigR + 56);

				if (dayValue) dayValue.textContent = day.toFixed(1);
				if (tiltValue) tiltValue.textContent = `${tilt}°`;
				setCopy(day);
			};

			const tick = (time) => {
				if (isPlaying && daySlider) {
					const delta = Math.min(64, time - last);
					const next = (Number(daySlider.value) + delta * 0.0026) % cycle;
					daySlider.value = String(next);
					draw();
				}
				last = time;
				frame = requestAnimationFrame(tick);
			};

			daySlider?.addEventListener('input', draw);
			tiltSlider?.addEventListener('input', draw);
			playButton?.addEventListener('click', () => {
				isPlaying = !isPlaying;
				const zh = playButton.querySelector('[data-locale="zh"]');
				const en = playButton.querySelector('[data-locale="en"]');
				if (zh) zh.textContent = isPlaying ? '暂停' : '播放';
				if (en) en.textContent = isPlaying ? 'Pause' : 'Play';
			});
			resetButton?.addEventListener('click', () => {
				if (daySlider) daySlider.value = '7.38';
				if (tiltSlider) tiltSlider.value = '12';
				isPlaying = false;
				const zh = playButton?.querySelector('[data-locale="zh"]');
				const en = playButton?.querySelector('[data-locale="en"]');
				if (zh) zh.textContent = '播放';
				if (en) en.textContent = 'Play';
				draw();
			});

			window.addEventListener('resize', () => {
				resizeCanvas();
				draw();
			});
			resizeCanvas();
			draw();
			frame = requestAnimationFrame(tick);
			window.addEventListener('pagehide', () => cancelAnimationFrame(frame));
		</script>
	</body>
</html>
