---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { categoryLabels, postText } from '../../lib/site-data';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categoryStats = Object.entries(categoryLabels)
	.filter(([key]) => key !== 'all')
	.map(([key, label]) => ({
		key,
		label,
		count: posts.filter((post) => post.data.category === key).length,
	}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`归档 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.archive-layout {
				display: grid;
				grid-template-columns: minmax(220px, 0.33fr) minmax(0, 1fr);
				gap: 1rem;
				align-items: start;
			}

			.archive-hero {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(240px, 0.36fr);
				gap: 1rem;
			}

			.archive-title,
			.archive-stat,
			.archive-aside,
			.search-panel {
				padding: clamp(1.15rem, 3vw, 2rem);
			}

			.archive-title p {
				max-width: 720px;
				color: var(--muted);
				font-size: 1.08rem;
			}

			.archive-stat {
				display: flex;
				flex-direction: column;
				justify-content: end;
				background: var(--inverse);
				color: var(--inverse-text);
			}

			.archive-stat strong {
				font-size: clamp(4rem, 10vw, 7rem);
				line-height: 0.88;
			}

			.archive-stat span {
				color: var(--inverse-muted);
			}

			.archive-aside {
				position: sticky;
				top: 88px;
				display: grid;
				gap: 0.8rem;
			}

			.category-tile {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.75rem;
				align-items: start;
				padding: 0.85rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel);
			}

			.category-dot {
				width: 0.8rem;
				height: 0.8rem;
				margin-top: 0.42rem;
				border-radius: 999px;
				background: var(--category-accent);
			}

			.category-tile strong {
				display: block;
			}

			.category-tile span {
				color: var(--muted);
				font-size: 0.82rem;
				line-height: 1.35;
			}

			.search-panel {
				display: grid;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}

			.search-field {
				width: 100%;
				min-height: 3rem;
				padding: 0.8rem 1rem;
				border: 1px solid var(--line);
				border-radius: 999px;
				background: var(--panel-strong);
				color: var(--ink);
			}

			.filter-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}

			.filter-button {
				min-height: 2.3rem;
				padding: 0.48rem 0.78rem;
				border: 1px solid var(--line);
				border-radius: 999px;
				background: transparent;
				color: var(--ink);
				cursor: pointer;
				font-weight: 700;
			}

			.filter-button[aria-pressed='true'] {
				background: var(--ink);
				color: var(--inverse-text);
			}

			.timeline {
				display: grid;
				gap: 0.75rem;
			}

			.archive-row {
				display: grid;
				grid-template-columns: 118px minmax(0, 1fr) auto;
				gap: 1rem;
				align-items: start;
				padding: 1rem;
				color: var(--ink);
				text-decoration: none;
				transition:
					transform 0.2s ease,
					border-color 0.2s ease,
					box-shadow 0.2s ease;
			}

			.archive-row:hover {
				transform: translateX(4px);
				border-color: rgba(201, 67, 56, 0.38);
				box-shadow: var(--soft-shadow);
			}

			.archive-row.is-hidden {
				display: none;
			}

			.archive-date {
				color: var(--muted);
				font-size: 0.84rem;
			}

			.archive-row h2 {
				margin: 0 0 0.24rem;
				color: var(--ink);
				font-size: clamp(1.35rem, 3vw, 2.35rem);
			}

			.archive-row p {
				margin: 0 0 0.75rem;
				color: var(--ink-soft);
				font-size: 0.96rem;
			}

			.archive-kind {
				color: var(--red);
				font-size: 0.86rem;
				font-weight: 700;
				white-space: nowrap;
			}

			.empty-state {
				display: none;
				padding: 1.2rem;
				color: var(--muted);
			}

			.empty-state.is-visible {
				display: block;
			}

			@media (max-width: 880px) {
				.archive-layout,
				.archive-hero,
				.archive-row {
					grid-template-columns: 1fr;
				}

				.archive-aside {
					position: static;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="archive-layout">
			<section class="archive-hero">
				<div class="archive-title surface">
					<div class="eyebrow">Archive</div>
					<h1><span data-locale="zh">所有记录</span><span data-locale="en">All entries</span></h1>
					<p>
						<span data-locale="zh">这里是博客的时间索引。论文阅读、代码笔记、日记和零散想法都会按时间排好，也可以直接搜关键词。</span>
						<span data-locale="en">This is the time index for the site. Paper reading, code notes, diary fragments, and loose ideas stay in one searchable trail.</span>
					</p>
				</div>
				<div class="archive-stat surface">
					<strong>{posts.length}</strong>
					<span><span data-locale="zh">条已保存</span><span data-locale="en">entries saved</span></span>
				</div>
			</section>

			<aside class="archive-aside surface" aria-label="Archive categories">
				<div class="eyebrow">Kinds</div>
				{
					categoryStats.map((item) => (
						<div class="category-tile" style={`--category-accent: ${item.label.accent}`}>
							<div class="category-dot" aria-hidden="true"></div>
							<div>
								<strong>
									{item.count} · <span data-locale="zh">{item.label.zh}</span><span data-locale="en">{item.label.en}</span>
								</strong>
								<span>
									<span data-locale="zh">{item.label.descriptionZh}</span>
									<span data-locale="en">{item.label.descriptionEn}</span>
								</span>
							</div>
						</div>
					))
				}
			</aside>

			<section>
				<div class="search-panel surface">
					<label class="sr-only" for="archiveSearch">Search archive</label>
					<input
						class="search-field"
						id="archiveSearch"
						type="search"
						placeholder="搜索标题、摘要或标签"
						autocomplete="off"
					/>
					<div class="filter-row" aria-label="Archive filters">
						{
							Object.entries(categoryLabels).map(([key, label]) => (
								<button
									class="filter-button"
									type="button"
									data-filter={key}
									aria-pressed={key === 'all' ? 'true' : 'false'}
								>
									<span data-locale="zh">{label.zh}</span>
									<span data-locale="en">{label.en}</span>
								</button>
							))
						}
					</div>
				</div>

				<div class="timeline" id="archiveTimeline">
					{
						posts.map((post) => {
							const searchText = [
								post.data.title,
								postText[post.id]?.title,
								post.data.description,
								postText[post.id]?.description,
								post.data.category,
								...post.data.tags,
							]
								.filter(Boolean)
								.join(' ')
								.toLowerCase();
							return (
								<a
									class="archive-row surface"
									data-category={post.data.category}
									data-search={searchText}
									href={`${base}/blog/${post.id}/`}
								>
									<div class="archive-date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<div>
										<h2>
											<span data-locale="zh">{post.data.title}</span>
											<span data-locale="en">{postText[post.id]?.title ?? post.data.title}</span>
										</h2>
										<p>
											<span data-locale="zh">{post.data.description}</span>
											<span data-locale="en">{postText[post.id]?.description ?? post.data.description}</span>
										</p>
										<div class="tag-row">
											{post.data.tags.map((tag, index) => (
												<span class="pill">
													<span data-locale="zh">{tag}</span>
													<span data-locale="en">{postText[post.id]?.tags?.[index] ?? tag}</span>
												</span>
											))}
										</div>
									</div>
									<div class="archive-kind">
										<span data-locale="zh">{categoryLabels[post.data.category].zh}</span>
										<span data-locale="en">{categoryLabels[post.data.category].en}</span>
									</div>
								</a>
							);
						})
					}
				</div>
				<div class="empty-state surface" id="emptyState">
					<span data-locale="zh">没有匹配的记录。</span>
					<span data-locale="en">No matching entries.</span>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const searchInput = document.querySelector('#archiveSearch');
			const filterButtons = document.querySelectorAll('[data-filter]');
			const rows = document.querySelectorAll('[data-category][data-search]');
			const emptyState = document.querySelector('#emptyState');
			let activeFilter = 'all';

			const updateRows = () => {
				const query = searchInput?.value.trim().toLowerCase() ?? '';
				let visible = 0;

				rows.forEach((row) => {
					const categoryMatches = activeFilter === 'all' || row.getAttribute('data-category') === activeFilter;
					const queryMatches = !query || row.getAttribute('data-search')?.includes(query);
					const shouldShow = categoryMatches && queryMatches;
					row.classList.toggle('is-hidden', !shouldShow);
					if (shouldShow) visible += 1;
				});

				emptyState?.classList.toggle('is-visible', visible === 0);
			};

			searchInput?.addEventListener('input', updateRows);
			filterButtons.forEach((button) => {
				button.addEventListener('click', () => {
					activeFilter = button.getAttribute('data-filter') ?? 'all';
					filterButtons.forEach((item) => {
						item.setAttribute('aria-pressed', String(item === button));
					});
					updateRows();
				});
			});
		</script>
	</body>
</html>
