---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { categoryLabels, experiments, postText, writingPrompts } from '../lib/site-data';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const recentPosts = posts.slice(0, 8);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const categoryStats = Object.entries(categoryLabels)
	.filter(([key]) => key !== 'all')
	.map(([key, label]) => ({
		key,
		label,
		count: posts.filter((post) => post.data.category === key).length,
	}));
const baseDate = posts[0]?.data.pubDate ?? new Date();
const latestDate = new Intl.DateTimeFormat('zh-CN', {
	month: 'short',
	day: 'numeric',
}).format(baseDate);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home-main {
				display: grid;
				gap: 1.15rem;
			}

			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.72fr);
				gap: 1rem;
				align-items: stretch;
				min-height: 600px;
			}

			.hero-copy {
				position: relative;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				min-height: 100%;
				padding: clamp(1.35rem, 3.8vw, 2.7rem);
				overflow: hidden;
				background:
					linear-gradient(145deg, var(--panel-strong), color-mix(in srgb, var(--paper-deep) 40%, transparent)),
					var(--panel);
			}

			.hero-copy::after {
				content: "";
				position: absolute;
				right: clamp(1rem, 5vw, 4rem);
				bottom: clamp(1rem, 4vw, 3rem);
				width: clamp(8rem, 23vw, 17rem);
				aspect-ratio: 1;
				border: 1px solid var(--line);
				border-radius: 999px;
				background:
					linear-gradient(90deg, transparent 49%, rgba(var(--black), 0.12) 50%, transparent 51%),
					linear-gradient(0deg, transparent 49%, rgba(var(--black), 0.12) 50%, transparent 51%);
				opacity: 0.28;
				pointer-events: none;
			}

			.hero-kicker {
				position: relative;
				z-index: 1;
			}

			.hero h1 {
				position: relative;
				z-index: 1;
				max-width: 9.4ch;
				margin-bottom: 1rem;
			}

			.hero-lead {
				position: relative;
				z-index: 1;
				max-width: 700px;
				color: var(--ink-soft);
				font-size: clamp(1.05rem, 2vw, 1.28rem);
			}

			.hero-actions {
				position: relative;
				z-index: 1;
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				margin-top: 1.6rem;
			}

			.hero-meta {
				position: relative;
				z-index: 1;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.7rem;
				margin-top: 2rem;
			}

			.metric {
				min-height: 7.2rem;
				padding: 0.95rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: color-mix(in srgb, var(--paper-soft) 72%, transparent);
			}

			.metric strong {
				display: block;
				font-size: clamp(2rem, 4vw, 3.6rem);
				line-height: 0.92;
			}

			.metric span {
				color: var(--muted);
				font-size: 0.84rem;
				line-height: 1.28;
			}

			.side-stack {
				display: grid;
				grid-template-rows: 1fr auto;
				gap: 1rem;
			}

			.prompt-panel {
				position: relative;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				min-height: 360px;
				padding: clamp(1.25rem, 3vw, 1.8rem);
				overflow: hidden;
				background: var(--inverse);
				color: var(--inverse-text);
			}

			.prompt-panel::after {
				content: "";
				position: absolute;
				inset: auto -4rem -5rem auto;
				width: 14rem;
				aspect-ratio: 1;
				border: 1px solid rgba(255, 248, 232, 0.16);
				border-radius: 999px;
				opacity: 0.7;
			}

			.panel-kicker {
				color: var(--inverse-muted);
				font-size: 0.76rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}

			.prompt {
				position: relative;
				z-index: 1;
				margin: 1.5rem 0;
				color: var(--inverse-text);
				font-size: clamp(1.45rem, 3vw, 2.35rem);
				line-height: 1.12;
			}

			.prompt-button {
				position: relative;
				z-index: 1;
				width: 100%;
				min-height: 3rem;
				padding: 0.9rem 1rem;
				border: 1px solid rgba(255, 248, 232, 0.2);
				border-radius: 999px;
				background: var(--red);
				color: #fff8e8;
				cursor: pointer;
				font: inherit;
				font-weight: 700;
				transition:
					transform 0.2s ease,
					background 0.2s ease;
			}

			.prompt-button:hover {
				background: #e35449;
				transform: translateY(-2px);
			}

			.mini-map {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.6rem;
				padding: 0.9rem;
			}

			.map-cell {
				min-height: 5.1rem;
				padding: 0.72rem;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				background: var(--panel);
			}

			.map-cell strong {
				display: block;
				margin-bottom: 0.18rem;
				font-size: 1.25rem;
			}

			.map-cell span {
				color: var(--muted);
				font-size: 0.78rem;
				line-height: 1.25;
			}

			.featured {
				display: grid;
				grid-template-columns: minmax(260px, 0.62fr) minmax(0, 1fr);
				gap: 0;
				overflow: hidden;
			}

			.featured-image {
				min-height: 360px;
				background: var(--paper-deep);
			}

			.featured-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}

			.featured-body {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: clamp(1.25rem, 3vw, 2rem);
			}

			.featured h2 {
				font-size: clamp(2.1rem, 5vw, 5.2rem);
			}

			.featured p {
				max-width: 720px;
				color: var(--ink-soft);
				font-size: 1.08rem;
			}

			.section-head {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 1rem;
				align-items: end;
				margin: 1.4rem 0 0.9rem;
			}

			.section-head p {
				max-width: 650px;
				color: var(--muted);
			}

			.filters {
				position: sticky;
				top: 78px;
				z-index: 12;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 0 0 1rem;
				padding: 0.68rem;
				background: var(--panel-strong);
				border: 1px solid var(--line);
				border-radius: var(--radius);
				backdrop-filter: blur(18px);
			}

			.filter-button {
				min-height: 2.5rem;
				padding: 0.55rem 0.86rem;
				border: 1px solid var(--line);
				border-radius: 999px;
				background: transparent;
				color: var(--ink);
				cursor: pointer;
				font: inherit;
				font-size: 0.88rem;
				font-weight: 700;
			}

			.filter-button[aria-pressed='true'] {
				background: var(--ink);
				color: var(--inverse-text);
			}

			.garden-grid {
				display: grid;
				grid-template-columns: repeat(12, 1fr);
				gap: 1rem;
			}

			.entry-card {
				grid-column: span 4;
				display: flex;
				flex-direction: column;
				min-height: 300px;
				padding: 1rem;
				color: var(--ink);
				text-decoration: none;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.entry-card:hover {
				transform: translateY(-4px);
				border-color: rgba(201, 67, 56, 0.42);
				box-shadow: var(--shadow);
			}

			.entry-card.is-hidden {
				display: none;
			}

			.entry-top {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
				color: var(--muted);
				font-size: 0.84rem;
			}

			.entry-card h3 {
				margin-bottom: 0.7rem;
				color: var(--ink);
			}

			.entry-card p {
				color: var(--ink-soft);
				font-size: 0.96rem;
			}

			.entry-card .tag-row {
				margin-top: auto;
			}

			.experiment-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}

			.experiment-card {
				position: relative;
				min-height: 320px;
				padding: clamp(1.2rem, 3vw, 1.8rem);
				overflow: hidden;
				color: var(--ink);
				text-decoration: none;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.experiment-card:hover {
				transform: translateY(-4px);
				border-color: rgba(35, 109, 143, 0.38);
				box-shadow: var(--shadow);
			}

			.experiment-card::after {
				content: "";
				position: absolute;
				right: -3rem;
				bottom: -3rem;
				width: 14rem;
				aspect-ratio: 1;
				border: 1px solid var(--line);
				border-radius: 999px;
				background:
					linear-gradient(90deg, transparent 48%, rgba(var(--black), 0.1) 49%, rgba(var(--black), 0.1) 51%, transparent 52%),
					linear-gradient(0deg, transparent 48%, rgba(var(--black), 0.1) 49%, rgba(var(--black), 0.1) 51%, transparent 52%);
				opacity: 0.45;
			}

			.experiment-card h3 {
				max-width: 9ch;
				font-size: clamp(2rem, 5vw, 4.2rem);
			}

			.experiment-card p {
				position: relative;
				z-index: 1;
				max-width: 520px;
				color: var(--ink-soft);
			}

			.category-strip {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
			}

			.category-card {
				padding: 1rem;
				border-top: 5px solid var(--category-accent);
			}

			.category-card strong {
				display: block;
				font-size: 2.5rem;
				line-height: 1;
			}

			.category-card span {
				color: var(--muted);
				font-size: 0.84rem;
			}

			@media (max-width: 960px) {
				.hero,
				.featured,
				.experiment-grid {
					grid-template-columns: 1fr;
				}

				.hero {
					min-height: auto;
				}

				.side-stack {
					grid-template-rows: auto;
				}

				.entry-card {
					grid-column: span 6;
				}

				.category-strip {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 640px) {
				.hero-copy,
				.prompt-panel,
				.featured-body {
					padding: 1rem;
				}

				.hero h1 {
					font-size: 3.2rem;
				}

				.hero-meta,
				.mini-map,
				.category-strip,
				.section-head {
					grid-template-columns: 1fr;
				}

				.filters {
					position: static;
				}

				.entry-card {
					grid-column: 1 / -1;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="hero">
				<div class="hero-copy surface">
					<div>
						<div class="eyebrow hero-kicker">Personal Garden</div>
						<h1>
							<span data-locale="zh">把日常写成可以探索的地图</span>
							<span data-locale="en">A map for notes, days, and experiments</span>
						</h1>
						<p class="hero-lead">
							<span data-locale="zh">这里收集技术笔记、论文阅读、日记和还没成熟的想法。它应该像 Josh 的文章一样好读，也允许像交互式长文一样把概念拖出来玩一玩。</span>
							<span data-locale="en">This place collects technical notes, paper reading, diary fragments, and immature ideas. It should read comfortably, then occasionally let an idea become something you can play with.</span>
						</p>
						<div class="hero-actions">
							<a class="button-link" href={`${base}/blog/`}>
								<span data-locale="zh">进入归档</span>
								<span data-locale="en">Open archive</span>
							</a>
							<a class="button-link secondary" href={`${base}/lab/`}>
								<span data-locale="zh">打开实验室</span>
								<span data-locale="en">Open lab</span>
							</a>
							<a class="button-link secondary" href={`${base}/game/`}>
								<span data-locale="zh">去游戏页</span>
								<span data-locale="en">Play the game</span>
							</a>
						</div>
					</div>
					<div class="hero-meta">
						<div class="metric">
							<strong>{posts.length}</strong>
							<span><span data-locale="zh">条记录</span><span data-locale="en">entries</span></span>
						</div>
						<div class="metric">
							<strong>{tagCount}</strong>
							<span><span data-locale="zh">个标签</span><span data-locale="en">tags</span></span>
						</div>
						<div class="metric">
							<strong>{latestDate}</strong>
							<span><span data-locale="zh">最近更新</span><span data-locale="en">latest update</span></span>
						</div>
					</div>
				</div>

				<aside class="side-stack">
					<div class="prompt-panel surface">
						<div>
							<div class="panel-kicker">Today's Prompt</div>
							<p class="prompt" id="promptText">
								<span data-locale="zh">{writingPrompts[0].zh}</span>
								<span data-locale="en">{writingPrompts[0].en}</span>
							</p>
						</div>
						<button class="prompt-button" id="promptButton" type="button">
							<span data-locale="zh">换一个写作提示</span>
							<span data-locale="en">New writing prompt</span>
						</button>
					</div>
					<div class="mini-map surface" aria-label="Site quick map">
						<div class="map-cell">
							<strong>Read</strong>
							<span data-locale="zh">舒适阅读页、目录和进度条</span>
							<span data-locale="en">Comfortable posts with TOC and progress</span>
						</div>
						<div class="map-cell">
							<strong>Think</strong>
							<span data-locale="zh">笔记状态、标签和归档</span>
							<span data-locale="en">Notes, tags, and archive trails</span>
						</div>
						<div class="map-cell">
							<strong>Play</strong>
							<span data-locale="zh">小实验和驾驶彩蛋</span>
							<span data-locale="en">Tiny experiments and a driving easter egg</span>
						</div>
						<div class="map-cell">
							<strong>About</strong>
							<span data-locale="zh">我是谁、在做什么、怎么写</span>
							<span data-locale="en">Who I am, what I do, how I write</span>
						</div>
					</div>
				</aside>
			</section>

			{
				featured && (
					<section class="featured surface">
						<div class="featured-image">
							{featured.data.heroImage && (
								<Image width={760} height={720} src={featured.data.heroImage} alt="" />
							)}
						</div>
						<div class="featured-body">
							<div>
								<div class="eyebrow">Featured Entry</div>
								<h2>
									<span data-locale="zh">{featured.data.title}</span>
									<span data-locale="en">{postText[featured.id]?.title ?? featured.data.title}</span>
								</h2>
								<p>
									<span data-locale="zh">{featured.data.description}</span>
									<span data-locale="en">{postText[featured.id]?.description ?? featured.data.description}</span>
								</p>
							</div>
							<div class="tag-row">
								<span class="pill">
									<span data-locale="zh">{categoryLabels[featured.data.category].zh}</span>
									<span data-locale="en">{categoryLabels[featured.data.category].en}</span>
								</span>
								{featured.data.mood && (
									<span class="pill">
										<span data-locale="zh">{featured.data.mood}</span>
										<span data-locale="en">{postText[featured.id]?.mood ?? featured.data.mood}</span>
									</span>
								)}
								<a class="pill" href={`${base}/blog/${featured.id}/`}>
									<span data-locale="zh">阅读这篇</span>
									<span data-locale="en">Read entry</span>
								</a>
							</div>
						</div>
					</section>
				)
			}

			<section aria-labelledby="garden-title">
				<div class="section-head">
					<div>
						<div class="eyebrow">Recent Entries</div>
						<h2 id="garden-title">
							<span data-locale="zh">最近放进来的东西</span>
							<span data-locale="en">Recent things placed here</span>
						</h2>
						<p>
							<span data-locale="zh">日记可以短，笔记可以粗糙，文章可以慢慢修。先保存，再长出结构。</span>
							<span data-locale="en">Diary can be short, notes can be rough, essays can be revised slowly. Save first, structure later.</span>
						</p>
					</div>
					<a class="button-link secondary" href={`${base}/blog/`}>
						<span data-locale="zh">完整归档</span>
						<span data-locale="en">Full archive</span>
					</a>
				</div>

				<div class="filters" aria-label="内容筛选">
					{
						Object.entries(categoryLabels).map(([key, label]) => (
							<button
								class="filter-button"
								type="button"
								data-filter={key}
								aria-pressed={key === 'all' ? 'true' : 'false'}
							>
								<span data-locale="zh">{label.zh}</span>
								<span data-locale="en">{label.en}</span>
							</button>
						))
					}
				</div>

				<div class="garden-grid" id="gardenGrid">
					{
						recentPosts.map((post) => (
							<a class="entry-card surface" data-category={post.data.category} href={`${base}/blog/${post.id}/`}>
								<div class="entry-top">
									<span>
										<span data-locale="zh">{categoryLabels[post.data.category].zh}</span>
										<span data-locale="en">{categoryLabels[post.data.category].en}</span>
									</span>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3>
									<span data-locale="zh">{post.data.title}</span>
									<span data-locale="en">{postText[post.id]?.title ?? post.data.title}</span>
								</h3>
								<p>
									<span data-locale="zh">{post.data.description}</span>
									<span data-locale="en">{postText[post.id]?.description ?? post.data.description}</span>
								</p>
								<div class="tag-row">
									{post.data.tags.slice(0, 3).map((tag, index) => (
										<span class="pill">
											<span data-locale="zh">{tag}</span>
											<span data-locale="en">{postText[post.id]?.tags?.[index] ?? tag}</span>
										</span>
									))}
								</div>
							</a>
						))
					}
				</div>
			</section>

			<section aria-labelledby="lab-title">
				<div class="section-head">
					<div>
						<div class="eyebrow">Interactive Corners</div>
						<h2 id="lab-title">
							<span data-locale="zh">把博客做成可以玩的地方</span>
							<span data-locale="en">Make the blog playable</span>
						</h2>
					</div>
				</div>
				<div class="experiment-grid">
					{
						experiments.map((item) => (
							<a class="experiment-card surface" href={`${base}${item.href}/`}>
								<div class="eyebrow">{item.kicker}</div>
								<h3>
									<span data-locale="zh">{item.titleZh}</span>
									<span data-locale="en">{item.titleEn}</span>
								</h3>
								<p>
									<span data-locale="zh">{item.descriptionZh}</span>
									<span data-locale="en">{item.descriptionEn}</span>
								</p>
							</a>
						))
					}
				</div>
			</section>

			<section class="category-strip" aria-label="Content categories">
				{
					categoryStats.map((item) => (
						<div class="category-card surface" style={`--category-accent: ${item.label.accent}`}>
							<strong>{item.count}</strong>
							<span>
								<span data-locale="zh">{item.label.zh} · {item.label.descriptionZh}</span>
								<span data-locale="en">{item.label.en} · {item.label.descriptionEn}</span>
							</span>
						</div>
					))
				}
			</section>
		</main>
		<Footer />

		<script define:vars={{ writingPrompts }}>
			const promptText = document.querySelector('#promptText');
			const promptButton = document.querySelector('#promptButton');
			let promptIndex = 0;

			promptButton?.addEventListener('click', () => {
				promptIndex = (promptIndex + 1) % writingPrompts.length;
				if (promptText) {
					const zh = promptText.querySelector('[data-locale="zh"]');
					const en = promptText.querySelector('[data-locale="en"]');
					if (zh) zh.textContent = writingPrompts[promptIndex].zh;
					if (en) en.textContent = writingPrompts[promptIndex].en;
				}
			});

			const filterButtons = document.querySelectorAll('[data-filter]');
			const cards = document.querySelectorAll('[data-category]');

			filterButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const filter = button.getAttribute('data-filter');

					filterButtons.forEach((item) => {
						item.setAttribute('aria-pressed', String(item === button));
					});

					cards.forEach((card) => {
						const shouldShow = filter === 'all' || card.getAttribute('data-category') === filter;
						card.classList.toggle('is-hidden', !shouldShow);
					});
				});
			});
		</script>
	</body>
</html>
