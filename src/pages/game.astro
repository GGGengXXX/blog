			const seededRandom = (seed) => {
				const value = Math.sin(seed * 127.1 + 311.7) * 43758.5453;
				return value - Math.floor(value);
			};

			const isDecorSafe = (x, z) => {
				const onRoad = (Math.abs(z) < 5 && Math.abs(x) < 62)
					|| (Math.abs(x) < 5 && Math.abs(z) < 48)
					|| (Math.abs(z + 19) < 4 && Math.abs(x) < 41)
					|| (Math.abs(z - 23) < 4 && Math.abs(x) < 44)
					|| (Math.abs(z - 37) < 4 && x < -36 && x > -74)
					|| (Math.abs(z + 33) < 4 && x > 36 && x < 74)
					|| (Math.abs(z - 16) < 4 && x > 25 && x < 70);
				const nearBuilding = [
					[-27, -20, 10, 8],
					[27, -20, 10, 8],
					[-27, 22, 12, 8],
					[27, 22, 11, 8],
					[-63, 42, 17, 16],
					[62, -43, 16, 16],
				].some(([cx, cz, hx, hz]) => Math.abs(x - cx) < hx && Math.abs(z - cz) < hz);
				const nearRiver = [
					[-62, -45, 23, 8],
					[-42, -31, 22, 8],
					[-21, -17, 20, 8],
					[4, -8, 18, 8],
					[28, 4, 20, 8],
					[51, 20, 22, 9],
					[70, 35, 22, 10],
				].some(([cx, cz, hx, hz]) => Math.abs(x - cx) < hx && Math.abs(z - cz) < hz);
				return !onRoad && !nearBuilding && !nearRiver;
			};

			const addGrassDetails = () => {
