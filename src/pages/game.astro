				const flowerGeometry = new THREE.SphereGeometry(0.14, 8, 6);
				const stoneGeometry = new THREE.DodecahedronGeometry(0.34, 0);
				const grassMesh = new THREE.InstancedMesh(grassGeometry, materials.grassDark, 1040);
				const flowerMesh = new THREE.InstancedMesh(flowerGeometry, materials.flowerYellow, 180);
				const stoneMesh = new THREE.InstancedMesh(stoneGeometry, materials.stone, 132);
				const dummy = new THREE.Object3D();
				let grassIndex = 0;
				let flowerIndex = 0;
				let stoneIndex = 0;

				for (let i = 0; i < 3300 && grassIndex < 1040; i += 1) {
					const x = (seededRandom(i + 11) - 0.5) * (world.width - 8);
					const z = (seededRandom(i + 97) - 0.5) * (world.depth - 8);
					if (!isDecorSafe(x, z)) continue;
					const scale = 0.72 + seededRandom(i + 203) * 0.7;
					dummy.position.set(x, 0.34 * scale, z);
					dummy.rotation.set(0, seededRandom(i + 304) * Math.PI * 2, 0);
					dummy.scale.setScalar(scale);
					dummy.updateMatrix();
					grassMesh.setMatrixAt(grassIndex, dummy.matrix);
					grassIndex += 1;

					if (flowerIndex < 180 && seededRandom(i + 401) > 0.7) {
						dummy.position.set(x + 0.34, 0.2, z - 0.2);
						dummy.rotation.set(0, 0, 0);
						dummy.scale.setScalar(1);
						dummy.updateMatrix();
						flowerMesh.setMatrixAt(flowerIndex, dummy.matrix);
						flowerIndex += 1;
					}

					if (stoneIndex < 132 && seededRandom(i + 503) > 0.84) {
						dummy.position.set(x - 0.45, 0.18, z + 0.28);
						dummy.rotation.set(seededRandom(i + 601), seededRandom(i + 602) * Math.PI, seededRandom(i + 603));
						dummy.scale.setScalar(0.8 + seededRandom(i + 604) * 0.55);
						dummy.updateMatrix();
						stoneMesh.setMatrixAt(stoneIndex, dummy.matrix);
						stoneIndex += 1;
					}
				}

				grassMesh.count = grassIndex;
				flowerMesh.count = flowerIndex;
				stoneMesh.count = stoneIndex;
				grassMesh.castShadow = true;
				flowerMesh.castShadow = true;
				stoneMesh.castShadow = true;
