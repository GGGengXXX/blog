			const emitBurst = (x, y, z, color, count = 22) => {
				for (let i = 0; i < count; i += 1) {
					const angle = (i / count) * Math.PI * 2 + seededRandom(i + sceneTime * 10) * 0.35;
					const speed = 2.2 + seededRandom(i + 41) * 4.4;
					spawnParticle({
						x,
						y,
						z,
						color,
						size: 0.55 + seededRandom(i + 72) * 0.55,
						life: 0.5 + seededRandom(i + 18) * 0.45,
						grow: 1.65,
						velocity: new THREE.Vector3(Math.cos(angle) * speed, 1.2 + seededRandom(i + 9) * 3.2, Math.sin(angle) * speed),
					});
				}
			};

			const setTransientMessage = (title, text, duration = 3.2) => {
				messageState.title = title;
				messageState.text = text;
