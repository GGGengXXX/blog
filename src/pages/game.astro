			const collectSpark = (spark, byPulse = false) => {
				if (spark.collected) return;
				spark.collected = true;
				spark.group.visible = false;
				effects.collected += 1;
				effects.cameraShake = Math.max(effects.cameraShake, 0.16);
				emitBurst(spark.group.position.x, 1.6, spark.group.position.z, spark.color, byPulse ? 30 : 22);
				const remaining = Math.max(0, collectibles.length - effects.collected);
				setTransientMessage(
					byPulse ? '扫描捕获' : '灵感捕获',
					remaining === 0 ? '灵感碎片已经全部点亮。' : `${spark.message} 还剩 ${remaining} 枚。`,
					2.8,
				);
			};

			const createPulse = () => {
				if (effects.pulseCooldown > 0) return;
				effects.pulseCooldown = 1.35;
				effects.cameraShake = Math.max(effects.cameraShake, 0.12);
				const material = materials.scan.clone();
				material.opacity = 0.82;
				const ring = new THREE.Mesh(new THREE.TorusGeometry(1, 0.055, 8, 96), material);
				ring.position.set(carState.x, 0.46, carState.z);
				ring.rotation.x = Math.PI / 2;
				ring.renderOrder = 8;
				scene.add(ring);
				pulseRings.push({ mesh: ring, material, age: 0, life: 0.82, maxRadius: 18 });

				let hitSomething = false;
				collectibles.forEach((spark) => {
					if (spark.collected) return;
					const distance = Math.hypot(carState.x - spark.group.position.x, carState.z - spark.group.position.z);
					if (distance < 14.5) {
						spark.magnetized = 1.4;
						hitSomething = true;
					}
				});

				memoryNodes.forEach((node) => {
					const distance = Math.hypot(carState.x - node.x, carState.z - node.z);
					if (distance < 16) {
						node.active = true;
						node.pulse = 1;
						node.material.emissiveIntensity = 0.52;
						setTransientMessage(node.title, node.message, 3.2);
						emitBurst(node.x, 2.8, node.z, node.material.color.getHex(), 16);
						hitSomething = true;
					}
				});

				if (!hitSomething) {
					setTransientMessage('信号脉冲', '扫描波扩散出去了，附近暂时没有可唤醒的东西。', 2.2);
				}
			};

			const updatePulseRings = (dt) => {
				for (let i = pulseRings.length - 1; i >= 0; i -= 1) {
					const pulse = pulseRings[i];
					pulse.age += dt;
					const t = pulse.age / pulse.life;
					const radius = 1 + t * pulse.maxRadius;
					pulse.mesh.scale.set(radius, radius, radius);
					pulse.material.opacity = Math.max(0, (1 - t) * 0.82);
					pulse.mesh.position.y = 0.46 + Math.sin(t * Math.PI) * 0.08;
					if (t >= 1) {
						scene.remove(pulse.mesh);
						pulse.mesh.geometry.dispose();
						pulse.material.dispose();
						pulseRings.splice(i, 1);
					}
				}
			};

			const updateCollectibles = (dt) => {
				collectibles.forEach((spark, index) => {
					if (spark.collected) return;
					spark.group.rotation.y += dt * (1.6 + index * 0.03);
					spark.group.position.y = spark.baseY + Math.sin(sceneTime * 2.4 + index) * 0.22;
					spark.ring.rotation.z -= dt * 1.8;
					if (spark.magnetized > 0) {
						spark.magnetized = Math.max(0, spark.magnetized - dt);
						const target = new THREE.Vector3(carState.x, 1.6, carState.z);
						spark.group.position.lerp(target, 1 - Math.pow(0.02, dt));
					}
					const distance = Math.hypot(carState.x - spark.group.position.x, carState.z - spark.group.position.z);
					if (distance < 3.1) collectSpark(spark, spark.magnetized > 0);
				});
			};

			const updateMemoryNodes = (dt) => {
				memoryNodes.forEach((node, index) => {
					node.halo.rotation.z += dt * (node.active ? 1.4 : 0.38);
					node.halo.position.y = 2.95 + Math.sin(sceneTime * 2.1 + index) * 0.12;
					node.pulse = Math.max(0, node.pulse - dt * 0.75);
					const activeGlow = node.active ? 0.22 : 0.05;
					node.material.emissiveIntensity = activeGlow + node.pulse * 0.35;
					node.group.scale.setScalar(1 + node.pulse * 0.04);
				});
			};

			const updateParticles = (dt) => {
				particles.forEach((particle) => {
					if (!particle.visible) return;
					particle.userData.age += dt;
					const age = particle.userData.age;
					const life = particle.userData.life;
					const t = age / life;
					if (t >= 1) {
						particle.visible = false;
						particle.material.opacity = 0;
						return;
					}
					particle.position.addScaledVector(particle.userData.velocity, dt);
					particle.userData.velocity.y -= 2.4 * dt;
					const scale = particle.userData.baseSize * (1 + t * particle.userData.grow);
					particle.scale.setScalar(scale);
					particle.material.opacity = Math.max(0, Math.pow(1 - t, 1.7) * 0.86);
				});
			};

			const emitDrivingEffects = (dt) => {
				const speed = Math.hypot(carState.vx, carState.vz);
				if (!carState.grounded || speed < 3) return;
				effects.dustTimer -= dt;
				const drifting = effects.drift > 0.32;
				const boosting = driveInput.boost > 0.35 && driveInput.throttle > 0.25 && effects.boostEnergy > 0.02;
				if (effects.dustTimer > 0 && !boosting) return;
				effects.dustTimer = boosting ? 0.018 : drifting ? 0.035 : 0.07;
				const backX = Math.sin(carState.heading);
				const backZ = Math.cos(carState.heading);
				const rightX = Math.cos(carState.heading);
				const rightZ = -Math.sin(carState.heading);
				[-1, 1].forEach((side) => {
					const color = boosting ? 0xffd37d : drifting ? 0xc8d0bd : 0x9fa68c;
					spawnParticle({
						x: carState.x + backX * 2.4 + rightX * side * 1.28,
						y: 0.42,
						z: carState.z + backZ * 2.4 + rightZ * side * 1.28,
						color,
						size: boosting ? 0.72 : 0.48,
						life: boosting ? 0.42 : 0.68,
						grow: boosting ? 1.2 : 1.85,
						velocity: new THREE.Vector3(backX * (boosting ? 5.5 : 2.1), 0.55, backZ * (boosting ? 5.5 : 2.1)),
					});
				});
			};

			const updateInteractions = (dt) => {
				effects.pulseCooldown = Math.max(0, effects.pulseCooldown - dt);
				if (effects.pulseQueued) {
					effects.pulseQueued = false;
					createPulse();
				}
				updateCollectibles(dt);
				updateMemoryNodes(dt);
				updatePulseRings(dt);
				emitDrivingEffects(dt);
				updateParticles(dt);
			};

