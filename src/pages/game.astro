---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`游戏 | ${SITE_TITLE}`} description="A 3D driving map for the blog." />
		<style>
			body {
				overflow: hidden;
				background: #111713;
			}

			.game-main {
				width: 100%;
				margin: 0;
				padding: 0;
			}

			.game-stage {
				position: relative;
				width: 100%;
				height: calc(100vh - 69px);
				min-height: 620px;
				overflow: hidden;
				background: #111713;
			}

			.three-mount {
				display: block;
				width: 100%;
				height: 100%;
				touch-action: none;
			}

			:global(.three-mount canvas) {
				display: block;
				width: 100% !important;
				height: 100% !important;
				touch-action: none;
			}

			.hud {
				position: absolute;
				inset: 1rem 1rem auto;
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				pointer-events: none;
			}

			.hud-card {
				min-width: 11rem;
				max-width: 22rem;
				padding: 0.78rem 0.9rem;
				border: 1px solid rgba(255, 248, 232, 0.18);
				border-radius: var(--radius);
				background: rgba(16, 17, 15, 0.7);
				color: #fff8e8;
				backdrop-filter: blur(14px);
				box-shadow: 0 18px 38px rgba(0, 0, 0, 0.22);
			}

			.hud-card strong {
				display: block;
				margin-bottom: 0.12rem;
				font-size: 1rem;
				line-height: 1.1;
			}

			.hud-card span {
				color: rgba(255, 248, 232, 0.68);
				font-size: 0.82rem;
				line-height: 1.28;
			}

			.enter-button {
				position: absolute;
				right: 1rem;
				bottom: 1rem;
				display: none;
				align-items: center;
				min-height: 3rem;
				padding: 0.8rem 1rem;
				border: 1px solid rgba(255, 248, 232, 0.24);
				border-radius: 999px;
				background: var(--red);
				color: #fff8e8;
				cursor: pointer;
				font-weight: 700;
				box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28);
			}

			.enter-button.is-visible {
				display: inline-flex;
			}

			.jump-button,
			.pulse-button {
				position: absolute;
				bottom: 1rem;
				display: none;
				width: 4rem;
				height: 4rem;
				place-items: center;
				border: 1px solid rgba(255, 248, 232, 0.22);
				border-radius: 999px;
				background: rgba(16, 17, 15, 0.72);
				color: #fff8e8;
				cursor: pointer;
				font-size: 1.45rem;
				font-weight: 800;
				backdrop-filter: blur(12px);
				box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28);
				user-select: none;
				transition:
					transform 0.12s ease,
					background 0.12s ease,
					border-color 0.12s ease;
			}

			.jump-button {
				right: 1rem;
			}

			.pulse-button {
				right: 5.45rem;
				font-size: 1.18rem;
			}

			.jump-button.is-pressed,
			.pulse-button.is-pressed {
				transform: translateY(2px) scale(0.96);
				border-color: rgba(255, 248, 232, 0.56);
				background: rgba(201, 67, 56, 0.84);
			}

			.pulse-button.is-cooling {
				opacity: 0.5;
			}

			.touch-controls {
				position: absolute;
				left: 1rem;
				bottom: 1rem;
				display: none;
				grid-template-columns: repeat(3, 3rem);
				grid-template-rows: repeat(2, 3rem);
				gap: 0.35rem;
			}

			.touch-button {
				display: inline-grid;
				place-items: center;
				border: 1px solid rgba(255, 248, 232, 0.2);
				border-radius: 999px;
				background: rgba(16, 17, 15, 0.68);
				color: #fff8e8;
				cursor: pointer;
				font-size: 1.12rem;
				font-weight: 700;
				backdrop-filter: blur(12px);
				user-select: none;
				transition:
					transform 0.12s ease,
					background 0.12s ease,
					border-color 0.12s ease;
			}

			.touch-button.is-pressed {
				transform: translateY(2px) scale(0.96);
				border-color: rgba(255, 248, 232, 0.54);
				background: rgba(201, 67, 56, 0.82);
			}

			.touch-button[data-control='up'] {
				grid-column: 2;
			}

			.touch-button[data-control='left'] {
				grid-column: 1;
				grid-row: 2;
			}

			.touch-button[data-control='down'] {
				grid-column: 2;
				grid-row: 2;
			}

			.touch-button[data-control='right'] {
				grid-column: 3;
				grid-row: 2;
			}

			@media (max-width: 720px) {
				body {
					overflow: auto;
				}

				.game-stage {
					height: calc(100vh - 128px);
					min-height: 560px;
				}

				.hud {
					inset: 0.7rem 0.7rem auto;
				}

				.hud-card {
					min-width: 0;
					max-width: 47%;
					padding: 0.62rem 0.7rem;
				}

				.hud-card span {
					display: none;
				}

				.touch-controls {
					display: grid;
				}

				.jump-button,
				.pulse-button {
					display: grid;
				}

				.enter-button.is-visible {
					bottom: 5.45rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="game-main">
			<section class="game-stage" id="gameStage" data-base={base} aria-label="3D blog driving map">
				<div class="three-mount" id="threeMount"></div>
				<div class="hud" aria-hidden="true">
					<div class="hud-card">
						<strong id="zoneName">Blog Town</strong>
						<span id="zoneHint">W/S 油门/倒车，A/D 转向，Space 跳跃，E 扫描。</span>
					</div>
					<div class="hud-card">
						<strong id="speedText">0 km/h</strong>
						<span id="progressText">灵感 0/0 · 扫描可用</span>
					</div>
				</div>
				<button class="enter-button" id="enterButton" type="button">Enter</button>
				<div class="touch-controls" aria-label="Touch driving controls">
					<button class="touch-button" type="button" data-control="up">↑</button>
					<button class="touch-button" type="button" data-control="left">←</button>
					<button class="touch-button" type="button" data-control="down">↓</button>
					<button class="touch-button" type="button" data-control="right">→</button>
				</div>
				<button class="jump-button" id="jumpButton" type="button" data-control="jump" aria-label="Jump">↥</button>
				<button class="pulse-button" id="pulseButton" type="button" data-control="pulse" aria-label="Pulse" title="Pulse">◎</button>
			</section>
		</main>

		<script>
			import * as THREE from 'three';
			import RAPIER from '@dimforge/rapier3d-compat';

			const stage = document.querySelector('#gameStage');
			const mount = document.querySelector('#threeMount');
			const zoneName = document.querySelector('#zoneName');
			const zoneHint = document.querySelector('#zoneHint');
			const speedText = document.querySelector('#speedText');
			const progressText = document.querySelector('#progressText');
			const enterButton = document.querySelector('#enterButton');
			const pulseButton = document.querySelector('#pulseButton');
			const base = stage?.getAttribute('data-base') ?? '';
			const keys = new Set();
			const world = { width: 242, depth: 194 };
			const carState = {
				x: 0,
				y: 0,
				z: 7,
				heading: 0,
				vx: 0,
				vy: 0,
				vz: 0,
				maxSpeed: 19,
				reverseSpeed: 8.5,
				acceleration: 27,
				turnRate: 1.55,
				grounded: false,
				jumpHeld: false,
				jumpQueued: false,
			};
			const driveInput = {
				throttle: 0,
				steer: 0,
				boost: 0,
			};
			const effects = {
				dustTimer: 0,
				boostEnergy: 1,
				pulseCooldown: 0,
				pulseQueued: false,
				particleCursor: 0,
				collected: 0,
				cameraShake: 0,
				wheelSpin: 0,
				drift: 0,
			};
			const messageState = {
				title: '',
				text: '',
				until: 0,
			};
			const physics = {
				world: null,
				carBody: null,
				carCollider: null,
				fixedDt: 1 / 60,
				accumulator: 0,
				carRadius: 2.6,
				ready: false,
			};
			const colliderSpecs = [];
			const jumpPads = [];
			const animatedProps = [];
			const particles = [];
			const pulseRings = [];
			const collectibles = [];
			const memoryNodes = [];
			let activeGate = null;
			let animationFrame = 0;
			let lastFrameTime = performance.now();
			let sceneTime = 0;

			const scene = new THREE.Scene();
			scene.background = new THREE.Color(0x9fb7a8);
			scene.fog = new THREE.Fog(0x9fb7a8, 82, 220);

			const camera = new THREE.OrthographicCamera(-20, 20, 15, -15, 0.1, 280);
			camera.position.set(30, 36, 30);
			scene.add(camera);

			const overlayScene = new THREE.Scene();
			const overlayCamera = new THREE.OrthographicCamera(-50, 50, 50, -50, 0.1, 100);
			overlayCamera.position.set(0, 0, 50);
			overlayCamera.lookAt(0, 0, 0);

			const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, preserveDrawingBuffer: true });
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
			renderer.shadowMap.enabled = true;
			renderer.outputColorSpace = THREE.SRGBColorSpace;
			renderer.autoClear = false;
			mount?.appendChild(renderer.domElement);

			const materials = {
				grass: new THREE.MeshStandardMaterial({ color: 0x2d593c, roughness: 0.95 }),
				grassLight: new THREE.MeshStandardMaterial({ color: 0x477046, roughness: 0.96 }),
				grassDark: new THREE.MeshStandardMaterial({ color: 0x22452f, roughness: 1 }),
				meadow: new THREE.MeshStandardMaterial({ color: 0x76934b, roughness: 0.92 }),
				meadowGold: new THREE.MeshStandardMaterial({ color: 0xc0a65a, roughness: 0.9 }),
				hill: new THREE.MeshStandardMaterial({ color: 0x56764f, roughness: 0.96 }),
				hillDark: new THREE.MeshStandardMaterial({ color: 0x385a45, roughness: 0.98 }),
				mountain: new THREE.MeshStandardMaterial({ color: 0x6b655f, roughness: 0.92 }),
				snow: new THREE.MeshStandardMaterial({ color: 0xe9eadf, roughness: 0.68 }),
				road: new THREE.MeshStandardMaterial({ color: 0x3d3931, roughness: 0.88 }),
				roadLine: new THREE.MeshStandardMaterial({ color: 0xe7dec8, roughness: 0.7 }),
				car: new THREE.MeshStandardMaterial({ color: 0xd6453b, roughness: 0.56, metalness: 0.08 }),
				carTop: new THREE.MeshStandardMaterial({ color: 0xfff3d5, roughness: 0.36 }),
				tire: new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.8 }),
				glass: new THREE.MeshStandardMaterial({ color: 0x86c7df, roughness: 0.25, metalness: 0.05 }),
				signPost: new THREE.MeshStandardMaterial({ color: 0x211f1a, roughness: 0.75 }),
				cream: new THREE.MeshStandardMaterial({ color: 0xf3ead8, roughness: 0.85 }),
				playerMarker: new THREE.MeshBasicMaterial({ color: 0xfff3d5 }),
				brick: new THREE.MeshStandardMaterial({ color: 0x9c4f3e, roughness: 0.72 }),
				brickTop: new THREE.MeshStandardMaterial({ color: 0xf1d4a8, roughness: 0.74 }),
				wood: new THREE.MeshStandardMaterial({ color: 0x7b5633, roughness: 0.86 }),
				bridge: new THREE.MeshStandardMaterial({ color: 0x8a6b42, roughness: 0.84 }),
				stone: new THREE.MeshStandardMaterial({ color: 0x9aa08d, roughness: 0.95 }),
				castleWall: new THREE.MeshStandardMaterial({ color: 0xb6b7aa, roughness: 0.82 }),
				castleRoof: new THREE.MeshStandardMaterial({ color: 0x506b80, roughness: 0.62 }),
				flowerRed: new THREE.MeshStandardMaterial({ color: 0xd6453b, roughness: 0.7 }),
				flowerYellow: new THREE.MeshStandardMaterial({ color: 0xe5b84b, roughness: 0.7 }),
				ramp: new THREE.MeshStandardMaterial({ color: 0xe2b05a, roughness: 0.58, metalness: 0.04 }),
				pad: new THREE.MeshStandardMaterial({ color: 0x8ed0d6, roughness: 0.34, emissive: 0x237580, emissiveIntensity: 0.22 }),
				lamp: new THREE.MeshBasicMaterial({ color: 0xffe6a6 }),
				notesPatch: new THREE.MeshStandardMaterial({ color: 0x405a4f, roughness: 0.96 }),
				diaryPatch: new THREE.MeshStandardMaterial({ color: 0x6d5657, roughness: 0.94 }),
				moonPatch: new THREE.MeshStandardMaterial({ color: 0x6b7180, roughness: 0.91 }),
				labPatch: new THREE.MeshStandardMaterial({ color: 0x47636c, roughness: 0.86 }),
				water: new THREE.MeshStandardMaterial({
					color: 0x2f8aa0,
					roughness: 0.18,
					metalness: 0.05,
					transparent: true,
					opacity: 0.74,
					emissive: 0x13495a,
					emissiveIntensity: 0.1,
				}),
				waterFoam: new THREE.MeshBasicMaterial({ color: 0xc7efe7, transparent: true, opacity: 0.62 }),
				page: new THREE.MeshStandardMaterial({ color: 0xf8ebd2, roughness: 0.72 }),
				ink: new THREE.MeshStandardMaterial({ color: 0x22201b, roughness: 0.82 }),
				lava: new THREE.MeshStandardMaterial({
					color: 0xe54b28,
					roughness: 0.34,
					emissive: 0xb51f12,
					emissiveIntensity: 0.85,
				}),
				lavaGlow: new THREE.MeshBasicMaterial({ color: 0xffb347, transparent: true, opacity: 0.76, depthWrite: false }),
				smoke: new THREE.MeshBasicMaterial({ color: 0x5f625b, transparent: true, opacity: 0.38, depthWrite: false }),
				sparkGold: new THREE.MeshStandardMaterial({
					color: 0xf0c25c,
					roughness: 0.28,
					emissive: 0xb56b1e,
					emissiveIntensity: 0.48,
				}),
				sparkBlue: new THREE.MeshStandardMaterial({
					color: 0x89d2df,
					roughness: 0.24,
					emissive: 0x247b91,
					emissiveIntensity: 0.48,
				}),
				scan: new THREE.MeshBasicMaterial({ color: 0xa8f0e8, transparent: true, opacity: 0.72, depthWrite: false }),
				boostGlow: new THREE.MeshBasicMaterial({ color: 0xffd37d, transparent: true, opacity: 0.82, depthWrite: false }),
			};

			const gates = [
				{ id: 'Garden', zh: '花园', href: '/', x: 0, z: -15.5, radius: 5.5, color: 0xc94338 },
				{ id: 'Archive', zh: '归档', href: '/blog/', x: -25, z: 0, radius: 5.8, color: 0x236d8f },
				{ id: 'Lab', zh: '实验室', href: '/lab/', x: 25, z: 0, radius: 5.8, color: 0xb67c2a },
				{ id: 'About', zh: '关于', href: '/about/', x: 0, z: 20, radius: 5.6, color: 0x377654 },
			];

			const routeZones = [
				{ name: '镜池河湾', hint: '河水、桥和涟漪会被扫描波点亮。', x: -29, z: 4, radius: 20 },
				{ name: '月面庭院', hint: '灰色地块里藏着几枚灵感碎片。', x: 27, z: -19, radius: 15 },
				{ name: '日记果园', hint: '纸页会在车经过时轻轻摆动。', x: -26, z: 23, radius: 14 },
				{ name: '信号实验场', hint: '扫描可以唤醒附近的小装置。', x: 27, z: 14, radius: 15 },
				{ name: '北部草原', hint: '草原更宽，适合加速、漂移和找隐藏碎片。', x: -8, z: -48, radius: 27 },
				{ name: '城堡山脊', hint: '城墙会挡车，城堡脚下有一枚蓝色碎片。', x: -63, z: 42, radius: 22 },
				{ name: '火山口', hint: '岩浆会发光，靠近时扫描波会唤醒火山信标。', x: 62, z: -43, radius: 24 },
			];

			const makeMesh = (geometry, material, position, rotation = [0, 0, 0], castShadow = false, receiveShadow = true) => {
				const mesh = new THREE.Mesh(geometry, material);
				mesh.position.set(position[0], position[1], position[2]);
				mesh.rotation.set(rotation[0], rotation[1], rotation[2]);
				mesh.castShadow = castShadow;
				mesh.receiveShadow = receiveShadow;
				scene.add(mesh);
				return mesh;
			};

			const addBoxColliderSpec = (x, z, width, depth, height, label) => {
				colliderSpecs.push({ type: 'box', x, z, width, depth, height, label });
			};

			const addCylinderColliderSpec = (x, z, radius, height, label) => {
				colliderSpecs.push({ type: 'cylinder', x, z, radius, height, label });
			};

			const makeLabelTexture = (label, color) => {
				const canvas = document.createElement('canvas');
				canvas.width = 512;
				canvas.height = 192;
				const ctx = canvas.getContext('2d');
				if (!ctx) return null;
				ctx.fillStyle = '#fff8e8';
				ctx.fillRect(0, 0, canvas.width, canvas.height);
				ctx.strokeStyle = color;
				ctx.lineWidth = 14;
				ctx.strokeRect(16, 16, canvas.width - 32, canvas.height - 32);
				ctx.fillStyle = color;
				ctx.font = '700 68px Atkinson, system-ui, sans-serif';
				ctx.fillText(label, 52, 92);
				ctx.fillStyle = '#3a352b';
				ctx.font = '700 28px Atkinson, system-ui, sans-serif';
				ctx.fillText('BLOG GATE', 54, 142);
				const texture = new THREE.CanvasTexture(canvas);
				texture.colorSpace = THREE.SRGBColorSpace;
				texture.anisotropy = 4;
				return texture;
			};

			const makePlayerTexture = () => {
				const canvas = document.createElement('canvas');
				canvas.width = 256;
				canvas.height = 96;
				const ctx = canvas.getContext('2d');
				if (!ctx) return null;
				ctx.fillStyle = '#fff8e8';
				ctx.beginPath();
				ctx.roundRect(10, 10, 236, 76, 24);
				ctx.fill();
				ctx.strokeStyle = '#171511';
				ctx.lineWidth = 8;
				ctx.stroke();
				ctx.fillStyle = '#171511';
				ctx.font = '700 42px Atkinson, system-ui, sans-serif';
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				ctx.fillText('YOU', 128, 50);
				const texture = new THREE.CanvasTexture(canvas);
				texture.colorSpace = THREE.SRGBColorSpace;
				texture.anisotropy = 4;
				return texture;
			};

			const addLights = () => {
				const hemi = new THREE.HemisphereLight(0xfff4dd, 0x27452e, 2.2);
				scene.add(hemi);

				const sun = new THREE.DirectionalLight(0xffe3b0, 3.2);
				sun.position.set(-38, 56, 42);
				sun.castShadow = true;
				sun.shadow.mapSize.set(2048, 2048);
				sun.shadow.camera.left = -104;
				sun.shadow.camera.right = 104;
				sun.shadow.camera.top = 92;
				sun.shadow.camera.bottom = -92;
				sun.shadow.camera.near = 1;
				sun.shadow.camera.far = 150;
				scene.add(sun);
			};

			const addGround = () => {
				makeMesh(new THREE.BoxGeometry(world.width + 96, 0.12, world.depth + 96), materials.water, [0, -0.46, 0], [0, 0, 0], false, false);
				makeMesh(new THREE.BoxGeometry(world.width + 26, 0.24, world.depth + 26), materials.grassLight, [0, -0.38, 0]);
				makeMesh(new THREE.BoxGeometry(world.width, 0.45, world.depth), materials.grass, [0, -0.25, 0]);
			};

			const addRoad = (x, z, width, depth) => {
				makeMesh(new THREE.BoxGeometry(width, 0.14, depth), materials.road, [x, 0.03, z]);
				const horizontal = width > depth;
				const count = horizontal ? Math.floor(width / 5) : Math.floor(depth / 5);
				for (let i = 0; i < count; i += 1) {
					const offset = (i - count / 2) * 5 + 2.5;
					makeMesh(
						new THREE.BoxGeometry(horizontal ? 2.4 : 0.18, 0.06, horizontal ? 0.18 : 2.4),
						materials.roadLine,
						[x + (horizontal ? offset : 0), 0.14, z + (horizontal ? 0 : offset)],
						[0, 0, 0],
						false,
						false,
					);
				}
			};

			const addRoads = () => {
				addRoad(0, 0, 118, 7.2);
				addRoad(0, 0, 7.2, 92);
				addRoad(0, -19, 78, 5.4);
				addRoad(0, 23, 84, 5.4);
				addRoad(-55, 37, 36, 5.2);
				addRoad(55, -33, 36, 5.2);
				addRoad(47, 16, 42, 5.2);
			};

			const addBuilding = (x, z, width, depth, height, color, label) => {
				const material = new THREE.MeshStandardMaterial({ color, roughness: 0.78 });
				const roof = new THREE.MeshStandardMaterial({ color: 0x211f1a, roughness: 0.72 });
				makeMesh(new THREE.BoxGeometry(width, height, depth), material, [x, height / 2, z], [0, 0, 0], true);
				makeMesh(new THREE.ConeGeometry(Math.max(width, depth) * 0.68, 2.6, 4), roof, [x, height + 1.3, z], [0, Math.PI / 4, 0], true);
				addBoxColliderSpec(x, z, width + 1.2, depth + 1.2, height + 1.2, label);

				const labelTexture = makeLabelTexture(label, '#211f1a');
				if (labelTexture) {
					const labelMaterial = new THREE.MeshBasicMaterial({ map: labelTexture, transparent: false });
					const labelMesh = new THREE.Mesh(new THREE.PlaneGeometry(width * 0.88, width * 0.33), labelMaterial);
					labelMesh.position.set(x, height * 0.6, z + depth / 2 + 0.035);
					scene.add(labelMesh);
				}
			};

			const addBuildings = () => {
				addBuilding(-27, -20, 12, 8, 8, 0x5c7b59, 'Notes');
				addBuilding(27, -20, 12, 8, 8.5, 0x665995, 'Moon');
				addBuilding(-27, 22, 15, 8, 7.6, 0x7b5047, 'Diary');
				addBuilding(27, 22, 13, 9, 8.2, 0x8b7431, 'Ideas');
			};

			const addTree = (x, z, scale = 1) => {
				const trunk = new THREE.MeshStandardMaterial({ color: 0x6a4b2d, roughness: 0.9 });
				const leaves = new THREE.MeshStandardMaterial({ color: 0x2f7a4d, roughness: 0.9 });
				makeMesh(new THREE.CylinderGeometry(0.22 * scale, 0.3 * scale, 1.6 * scale, 8), trunk, [x, 0.8 * scale, z], [0, 0, 0], true);
