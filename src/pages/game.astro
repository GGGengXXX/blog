			const spawnParticle = ({ x, y, z, color = 0xfff3d5, size = 1, life = 0.55, velocity = new THREE.Vector3(), grow = 0.8 }) => {
				if (particles.length === 0) return;
				const particle = particles[effects.particleCursor % particles.length];
				effects.particleCursor += 1;
				particle.visible = true;
				particle.position.set(x, y, z);
				particle.scale.setScalar(size);
				particle.material.color.setHex(color);
				particle.material.opacity = 0.92;
				particle.userData.age = 0;
