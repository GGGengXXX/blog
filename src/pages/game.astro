					car: createOverlayMaterial(0xd6453b),
					top: createOverlayMaterial(0xfff3d5),
					tire: createOverlayMaterial(0x111111),
					glass: createOverlayMaterial(0x8fd3e4, 0.92),
					light: createOverlayMaterial(0xffdfa1),
					shadow: createOverlayMaterial(0x171511, 0.22),
				};

				const addPart = (geometry, material, position, rotation = [0, 0, 0]) => {
					const mesh = new THREE.Mesh(geometry, material);
					mesh.position.set(position[0], position[1], position[2]);
					mesh.rotation.set(rotation[0], rotation[1], rotation[2]);
					mesh.renderOrder = 42;
					mesh.frustumCulled = false;
					shell.add(mesh);
					return mesh;
				};

				addPart(new THREE.BoxGeometry(9.8, 15.2, 0.36), overlayMaterials.shadow, [0, -0.7, -0.38]);
				addPart(new THREE.BoxGeometry(8.4, 13.4, 1.25), overlayMaterials.car, [0, 0, 0.1]);
				addPart(new THREE.BoxGeometry(5.6, 4.8, 1.5), overlayMaterials.top, [0, 0.8, 0.92]);
				addPart(new THREE.BoxGeometry(4.4, 1.4, 0.18), overlayMaterials.glass, [0, 2.9, 1.74]);
				addPart(new THREE.BoxGeometry(3.8, 1.15, 0.18), overlayMaterials.glass, [0, -1.5, 1.74]);
				addPart(new THREE.ConeGeometry(1.1, 2.7, 3), overlayMaterials.top, [0, 7.55, 1.06], [0, 0, Math.PI]);

				const wheelGeometry = new THREE.CylinderGeometry(0.9, 0.9, 0.72, 18);
				[
					[-4.58, 4.05, 0.22],
					[4.58, 4.05, 0.22],
					[-4.58, -4.15, 0.22],
					[4.58, -4.15, 0.22],
				].forEach(([x, y, z]) => {
					addPart(wheelGeometry, overlayMaterials.tire, [x, y, z], [0, 0, Math.PI / 2]);
				});

				[-1.55, 1.55].forEach((x) => {
					addPart(new THREE.BoxGeometry(1.1, 0.5, 0.2), overlayMaterials.light, [x, 6.92, 0.96]);
				});

				const playerTexture = makePlayerTexture();
				if (playerTexture) {
					const spriteMaterial = new THREE.SpriteMaterial({
						map: playerTexture,
						depthTest: false,
						depthWrite: false,
					});
					const sprite = new THREE.Sprite(spriteMaterial);
					sprite.position.set(0, 11.5, 1.1);
					sprite.scale.set(8.2, 3.05, 1);
					sprite.renderOrder = 48;
					sprite.frustumCulled = false;
					group.add(sprite);
				}

				group.userData.shell = shell;
				return group;
			};

			const car = createCar();
			const mobileAvatar = createMobileAvatar();
			overlayScene.add(mobileAvatar);
			mobileAvatar.visible = false;

			const createFixedBoxCollider = (x, y, z, hx, hy, hz, friction = 0.35) => {
				if (!physics.world) return null;
				return physics.world.createCollider(
					RAPIER.ColliderDesc.cuboid(hx, hy, hz)
						.setTranslation(x, y, z)
						.setFriction(friction)
						.setRestitution(0.02),
				);
			};

			const setupPhysics = async () => {
				await RAPIER.init();
				physics.world = new RAPIER.World({ x: 0, y: -28, z: 0 });
				physics.world.timestep = physics.fixedDt;
				physics.world.numSolverIterations = 8;
				physics.world.maxCcdSubsteps = 2;

				createFixedBoxCollider(0, -0.28, 0, world.width / 2 + 5, 0.28, world.depth / 2 + 5, 0.04);
				createFixedBoxCollider(0, 2, -world.depth / 2 - 1.8, world.width / 2 + 5, 2, 1.2, 0.25);
				createFixedBoxCollider(0, 2, world.depth / 2 + 1.8, world.width / 2 + 5, 2, 1.2, 0.25);
				createFixedBoxCollider(-world.width / 2 - 1.8, 2, 0, 1.2, 2, world.depth / 2 + 5, 0.25);
				createFixedBoxCollider(world.width / 2 + 1.8, 2, 0, 1.2, 2, world.depth / 2 + 5, 0.25);

				colliderSpecs.forEach((spec) => {
					if (spec.type === 'box') {
						createFixedBoxCollider(
							spec.x,
							spec.height / 2,
							spec.z,
							spec.width / 2,
							spec.height / 2,
							spec.depth / 2,
							0.28,
						);
					}
					if (spec.type === 'cylinder' && physics.world) {
						physics.world.createCollider(
							RAPIER.ColliderDesc.cylinder(spec.height / 2, spec.radius)
								.setTranslation(spec.x, spec.height / 2, spec.z)
								.setFriction(0.22)
								.setRestitution(0.04),
						);
					}
				});

				const bodyDesc = RAPIER.RigidBodyDesc.dynamic()
					.setTranslation(carState.x, physics.carRadius + 0.04, carState.z)
					.setLinearDamping(0.1)
					.setAngularDamping(10)
					.setCanSleep(false)
					.setCcdEnabled(true)
					.lockRotations();
				physics.carBody = physics.world.createRigidBody(bodyDesc);
				physics.carCollider = physics.world.createCollider(
					RAPIER.ColliderDesc.ball(physics.carRadius)
						.setDensity(1.4)
						.setFriction(0.02)
						.setRestitution(0.04),
					physics.carBody,
				);
				physics.ready = true;
			};

			const isNarrowViewport = () => camera.aspect < 0.75;

			const syncResponsiveMode = () => {
				const narrow = isNarrowViewport();
				car.visible = !narrow;
				mobileAvatar.visible = narrow;
			};

			const updateCarObject = () => {
				car.position.set(carState.x, carState.y, carState.z);
				car.rotation.y = carState.heading;
				if (mobileAvatar.userData.shell) {
					mobileAvatar.userData.shell.rotation.z = -carState.heading;
				}
			};

			const updateCarVisuals = (dt) => {
				const speed = Math.hypot(carState.vx, carState.vz);
				const speedRatio = Math.min(speed / carState.maxSpeed, 1);
				effects.wheelSpin += (carState.vx * -Math.sin(carState.heading) + carState.vz * -Math.cos(carState.heading)) * dt * 1.7;
				const visualRoll = -driveInput.steer * speedRatio * 0.16;
				const visualPitch = -driveInput.throttle * 0.045 + Math.max(-0.06, Math.min(0.08, carState.vy * 0.012));
				car.rotation.set(visualPitch, carState.heading, visualRoll);
				car.userData.wheels?.forEach((wheel) => {
					wheel.rotation.x = effects.wheelSpin;
				});
				car.userData.frontWheels?.forEach((wheel) => {
					wheel.rotation.y = driveInput.steer * 0.34;
				});
				if (car.userData.markerRing) {
					car.userData.markerRing.rotation.z += dt * (1.1 + speedRatio * 2.2);
				}
				if (mobileAvatar.userData.shell) {
					mobileAvatar.userData.shell.scale.setScalar(1 + speedRatio * 0.035);
				}
			};

			const resize = () => {
				if (!mount) return;
				const rect = mount.getBoundingClientRect();
				camera.aspect = Math.max(1, rect.width) / Math.max(1, rect.height);
				const viewHeight = isNarrowViewport() ? 108 : 42;
				const viewWidth = viewHeight * camera.aspect;
				camera.left = -viewWidth / 2;
				camera.right = viewWidth / 2;
				camera.top = viewHeight / 2;
				camera.bottom = -viewHeight / 2;
				camera.updateProjectionMatrix();
				overlayCamera.left = -50 * camera.aspect;
				overlayCamera.right = 50 * camera.aspect;
				overlayCamera.top = 50;
				overlayCamera.bottom = -50;
				overlayCamera.updateProjectionMatrix();
				renderer.setSize(rect.width, rect.height, false);
				syncResponsiveMode();
			};

			const clampCar = () => {
				carState.x = Math.max(-world.width / 2 + 3, Math.min(world.width / 2 - 3, carState.x));
				carState.z = Math.max(-world.depth / 2 + 3, Math.min(world.depth / 2 - 3, carState.z));
			};

			const moveToward = (current, target, maxDelta) => {
				if (Math.abs(target - current) <= maxDelta) return target;
				return current + Math.sign(target - current) * maxDelta;
			};

			const dampValue = (current, target, smoothing, dt) => {
				return current + (target - current) * (1 - Math.exp(-smoothing * dt));
			};

			const getInputState = () => {
				const forward = keys.has('arrowup') || keys.has('w');
				const reverse = keys.has('arrowdown') || keys.has('s');
				const left = keys.has('arrowleft') || keys.has('a');
				const right = keys.has('arrowright') || keys.has('d');
				const jump = keys.has(' ');
				const boost = keys.has('shift');
				return {
					throttle: (forward ? 1 : 0) - (reverse ? 1 : 0),
					steer: (right ? 1 : 0) - (left ? 1 : 0),
					jump,
					boost,
				};
			};

			const syncCarStateFromPhysics = () => {
				if (!physics.carBody) return;
				const position = physics.carBody.translation();
				const velocity = physics.carBody.linvel();
				carState.x = position.x;
				carState.y = Math.max(0, position.y - physics.carRadius);
				carState.z = position.z;
				carState.vx = velocity.x;
				carState.vy = velocity.y;
				carState.vz = velocity.z;
				updateCarObject();
			};

			const isCarGrounded = () => {
				if (!physics.world || !physics.carBody) return false;
				const position = physics.carBody.translation();
				const velocity = physics.carBody.linvel();
				const ray = new RAPIER.Ray(position, { x: 0, y: -1, z: 0 });
				const hit = physics.world.castRay(
					ray,
					physics.carRadius + 0.18,
					true,
					undefined,
					undefined,
					physics.carCollider ?? undefined,
					physics.carBody,
				);
				return Boolean(hit) && velocity.y <= 1.2;
			};

			const resetCarToRoad = () => {
				if (!physics.carBody) return;
				carState.heading = 0;
				physics.carBody.setTranslation({ x: 0, y: physics.carRadius + 0.12, z: 7 }, true);
				physics.carBody.setLinvel({ x: 0, y: 0, z: 0 }, true);
				physics.carBody.setAngvel({ x: 0, y: 0, z: 0 }, true);
				syncCarStateFromPhysics();
			};

			const drivePhysicsStep = (stepDt) => {
				if (!physics.world || !physics.carBody) return;
				const input = getInputState();
				const velocity = physics.carBody.linvel();
				carState.grounded = isCarGrounded();
				driveInput.throttle = dampValue(driveInput.throttle, input.throttle, input.throttle === 0 ? 8.5 : 5.4, stepDt);
				driveInput.steer = dampValue(driveInput.steer, input.steer, input.steer === 0 ? 10.5 : 7.6, stepDt);
				driveInput.boost = dampValue(driveInput.boost, input.boost ? 1 : 0, input.boost ? 7.5 : 5.8, stepDt);

				const boostIntent = driveInput.boost > 0.18 && driveInput.throttle > 0.18 && effects.boostEnergy > 0.02;
				if (boostIntent) {
					effects.boostEnergy = Math.max(0, effects.boostEnergy - stepDt * 0.34);
					effects.cameraShake = Math.max(effects.cameraShake, 0.06);
				} else {
					effects.boostEnergy = Math.min(1, effects.boostEnergy + stepDt * 0.18);
				}

				const horizontalSpeed = Math.hypot(velocity.x, velocity.z);
				const speedRatio = Math.min(horizontalSpeed / carState.maxSpeed, 1);
				const turningGrip = Math.max(0.34, Math.min(0.92, Math.sqrt(speedRatio + 0.04)));
				if (Math.abs(driveInput.steer) > 0.01) {
					carState.heading -= driveInput.steer * carState.turnRate * turningGrip * stepDt;
				}

				const forwardX = -Math.sin(carState.heading);
				const forwardZ = -Math.cos(carState.heading);
				const rightX = Math.cos(carState.heading);
				const rightZ = -Math.sin(carState.heading);
				const forwardSpeed = velocity.x * forwardX + velocity.z * forwardZ;
				const lateralSpeed = velocity.x * rightX + velocity.z * rightZ;
				const boostedMaxSpeed = carState.maxSpeed * (boostIntent ? 1.34 : 1);
				const targetForwardSpeed = driveInput.throttle > 0.03
					? boostedMaxSpeed * driveInput.throttle
					: driveInput.throttle < -0.03
						? -carState.reverseSpeed * Math.abs(driveInput.throttle)
						: 0;
				const acceleration = Math.abs(driveInput.throttle) < 0.04
					? carState.acceleration * 0.76
					: carState.acceleration * (boostIntent ? 1.26 : 1);
				const nextForwardSpeed = moveToward(forwardSpeed, targetForwardSpeed, acceleration * stepDt);
				const lateralGrip = carState.grounded ? (boostIntent ? 5.2 : 8.2) : 1.15;
				const nextLateralSpeed = lateralSpeed * Math.max(0, 1 - lateralGrip * stepDt);
				effects.drift = Math.min(1, Math.abs(lateralSpeed) / 8 + Math.abs(driveInput.steer) * speedRatio * 0.72);

				let nextY = velocity.y;
				const jumpRequested = input.jump || carState.jumpQueued;
				if (jumpRequested && !carState.jumpHeld && carState.grounded) {
					nextY = 10.4;
					carState.grounded = false;
				}
				jumpPads.forEach((pad) => {
					pad.cooldown = Math.max(0, pad.cooldown - stepDt);
					const dx = carState.x - pad.x;
					const dz = carState.z - pad.z;
					if (pad.cooldown <= 0 && carState.grounded && horizontalSpeed > 3.5 && Math.hypot(dx, dz) < pad.radius) {
						nextY = Math.max(nextY, pad.boost);
						pad.cooldown = 0.8;
						carState.grounded = false;
						effects.cameraShake = Math.max(effects.cameraShake, 0.22);
						emitBurst(pad.x, 0.85, pad.z, 0x8ed0d6, 18);
					}
				});
				carState.jumpQueued = false;
				carState.jumpHeld = input.jump;

				physics.carBody.setRotation({ x: 0, y: Math.sin(carState.heading / 2), z: 0, w: Math.cos(carState.heading / 2) }, true);
				physics.carBody.setLinvel(
					{
						x: forwardX * nextForwardSpeed + rightX * nextLateralSpeed,
						y: nextY,
						z: forwardZ * nextForwardSpeed + rightZ * nextLateralSpeed,
					},
					true,
				);
				physics.world.step();
				syncCarStateFromPhysics();

				const halfWidth = world.width / 2 + 6;
				const halfDepth = world.depth / 2 + 6;
				if (Math.abs(carState.x) > halfWidth || Math.abs(carState.z) > halfDepth || carState.y < -8) {
					resetCarToRoad();
				}
			};

			const getActiveGate = () => {
				return gates.find((gate) => {
					const dx = carState.x - gate.x;
					const dz = carState.z - gate.z;
					return Math.hypot(dx, dz) <= gate.radius;
				}) ?? null;
			};

			const getCurrentZone = () => {
				return routeZones.find((zone) => Math.hypot(carState.x - zone.x, carState.z - zone.z) <= zone.radius) ?? null;
			};

			const setHud = () => {
				activeGate = getActiveGate();
				const currentZone = getCurrentZone();
				const hasMessage = sceneTime < messageState.until;
				if (zoneName) {
					zoneName.textContent = hasMessage
						? messageState.title
						: activeGate
							? `${activeGate.id} Gate`
							: currentZone?.name ?? 'Blog Town';
				}
				if (zoneHint) {
					zoneHint.textContent = hasMessage
						? messageState.text
						: activeGate
							? `按 Enter 进入${activeGate.zh}`
							: currentZone?.hint ?? 'W/S 前进/倒车，A/D 转向，Space 跳跃，E 扫描，Shift 加速。';
				}
				const speed = Math.hypot(carState.vx, carState.vz);
				if (speedText) speedText.textContent = `${Math.round(speed * 3.6)} km/h`;
				if (progressText) {
					const pulseState = effects.pulseCooldown > 0 ? `${Math.ceil(effects.pulseCooldown * 10) / 10}s` : 'ready';
					const activeNodeCount = memoryNodes.filter((node) => node.active).length;
					progressText.textContent = `灵感 ${effects.collected}/${collectibles.length} · 信标 ${activeNodeCount}/${memoryNodes.length} · 扫描 ${pulseState === 'ready' ? '可用' : pulseState}`;
				}
				if (pulseButton) pulseButton.classList.toggle('is-cooling', effects.pulseCooldown > 0);
				if (enterButton) {
					enterButton.classList.toggle('is-visible', Boolean(activeGate));
					enterButton.textContent = activeGate ? `Enter ${activeGate.id}` : 'Enter';
				}
			};

			const updateGateFeedback = () => {
				gates.forEach((gate) => {
					const isActive = gate === activeGate;
					const pulse = isActive ? 1.08 + Math.sin(sceneTime * 6) * 0.06 : 1;
					gate.ring?.scale.set(pulse, pulse, pulse);
					gate.disk?.scale.set(isActive ? 1.03 : 1, 1, isActive ? 1.03 : 1);
					if (gate.accent) gate.accent.emissiveIntensity = isActive ? 0.58 : 0.18;
				});
			};

			const updateCamera = (dt) => {
				const narrow = isNarrowViewport();
				const targetPosition = new THREE.Vector3(
					carState.x + (narrow ? 20 : 22),
					narrow ? 32 : 28,
					carState.z + (narrow ? 20 : 22),
				);
				effects.cameraShake = Math.max(0, effects.cameraShake - dt * 0.8);
				if (effects.cameraShake > 0.01) {
					const shake = effects.cameraShake * (narrow ? 0.35 : 0.7);
					targetPosition.x += Math.sin(sceneTime * 38) * shake;
					targetPosition.z += Math.cos(sceneTime * 31) * shake;
				}
				camera.position.lerp(targetPosition, 1 - Math.pow(0.001, dt));
				const lookTarget = new THREE.Vector3(carState.x, 1.1 + Math.min(carState.y, 3), carState.z);
				camera.lookAt(lookTarget);
			};

			const lerpAngle = (from, to, amount) => {
				const diff = Math.atan2(Math.sin(to - from), Math.cos(to - from));
				return from + diff * amount;
			};

			const updatePhysics = (dt) => {
				if (!physics.ready) return;
				physics.accumulator = Math.min(physics.accumulator + dt, 0.18);
				let steps = 0;
				while (physics.accumulator >= physics.fixedDt && steps < 8) {
					drivePhysicsStep(physics.fixedDt);
					physics.accumulator -= physics.fixedDt;
					steps += 1;
				}
				setHud();
				updateGateFeedback();
			};

			const updateAnimatedProps = () => {
				animatedProps.forEach((prop, index) => {
					const delta = 0.012 * prop.spin;
					if (prop.axis === 'x') prop.mesh.rotation.x += delta;
					else if (prop.axis === 'y') prop.mesh.rotation.y += delta;
					else prop.mesh.rotation.z += delta;
					prop.mesh.position.y = prop.baseY + Math.sin(sceneTime * 2.2 + index) * (prop.wobble ?? 0.08);
				});
			};

			const openActiveGate = () => {
				if (!activeGate) return;
				const href = activeGate.href === '/' ? `${base}/` : `${base}${activeGate.href}`;
				window.location.href = href;
			};

			const normalizeControlKey = (event) => {
				if (event.code === 'Space') return ' ';
				return event.key.toLowerCase();
			};

			const bindControls = () => {
				window.addEventListener('keydown', (event) => {
					const key = normalizeControlKey(event);
					if (['arrowup', 'arrowdown', 'arrowleft', 'arrowright', 'w', 'a', 's', 'd', ' ', 'shift', 'e'].includes(key)) {
						event.preventDefault();
						keys.add(key);
						if (key === ' ' && !event.repeat) carState.jumpQueued = true;
						if (key === 'e' && !event.repeat) effects.pulseQueued = true;
					}
					if (key === 'enter') {
						event.preventDefault();
						openActiveGate();
					}
				});
				window.addEventListener('keyup', (event) => {
					keys.delete(normalizeControlKey(event));
				});

				document.querySelectorAll('[data-control]').forEach((button) => {
					const keyMap = { up: 'w', down: 's', left: 'a', right: 'd', jump: ' ', pulse: 'e' };
					const key = keyMap[button.getAttribute('data-control')];
					if (!key) return;
					const press = (event) => {
						event.preventDefault();
						button.classList.add('is-pressed');
						keys.add(key);
						if (key === ' ') carState.jumpQueued = true;
						if (key === 'e') effects.pulseQueued = true;
					};
					const release = (event) => {
						event.preventDefault();
						button.classList.remove('is-pressed');
						keys.delete(key);
					};
					button.addEventListener('pointerdown', press);
					button.addEventListener('pointerup', release);
					button.addEventListener('pointerleave', release);
					button.addEventListener('pointercancel', release);
				});

				enterButton?.addEventListener('click', openActiveGate);
				window.addEventListener('resize', resize);
				window.addEventListener('pagehide', () => cancelAnimationFrame(animationFrame));
			};

			const animate = () => {
				const now = performance.now();
				const dt = Math.min((now - lastFrameTime) / 1000, 0.05);
				lastFrameTime = now;
				sceneTime += dt;
				updatePhysics(dt);
				updateInteractions(dt);
				updateAnimatedProps();
				updateCarVisuals(dt);
				updateCamera(dt);
				renderer.clear();
				renderer.render(scene, camera);
				if (mobileAvatar.visible) {
					renderer.clearDepth();
					renderer.render(overlayScene, overlayCamera);
				}
				const carScreen = car.position.clone().project(camera);
				const carBox = new THREE.Box3().setFromObject(car);
				const carBoxCenter = carBox.getCenter(new THREE.Vector3()).project(camera);
				const avatarScreen = mobileAvatar.position.clone().project(overlayCamera);
				window.__blogGameDebug = {
					mode: mobileAvatar.visible ? 'mobile-overlay' : 'desktop-world',
					physicsReady: physics.ready,
					x: Number(carState.x.toFixed(2)),
					y: Number(carState.y.toFixed(2)),
					z: Number(carState.z.toFixed(2)),
					speed: Number(Math.hypot(carState.vx, carState.vz).toFixed(2)),
					vy: Number(carState.vy.toFixed(2)),
					heading: Number(carState.heading.toFixed(3)),
					grounded: carState.grounded,
					collected: effects.collected,
					totalCollectibles: collectibles.length,
					activeBeacons: memoryNodes.filter((node) => node.active).length,
					totalBeacons: memoryNodes.length,
					pulseCooldown: Number(effects.pulseCooldown.toFixed(2)),
					pulseRings: pulseRings.length,
					visibleParticles: particles.filter((particle) => particle.visible).length,
					avatarVisible: mobileAvatar.visible,
					activeGate: activeGate?.id ?? null,
					screen: {
						x: Number(carScreen.x.toFixed(3)),
						y: Number(carScreen.y.toFixed(3)),
					},
					boxScreen: {
						x: Number(carBoxCenter.x.toFixed(3)),
						y: Number(carBoxCenter.y.toFixed(3)),
					},
					avatarScreen: {
						x: Number(avatarScreen.x.toFixed(3)),
						y: Number(avatarScreen.y.toFixed(3)),
					},
					canvas: {
						width: renderer.domElement.width,
						height: renderer.domElement.height,
					},
				};
				animationFrame = requestAnimationFrame(animate);
			};

			const startGame = async () => {
				addLights();
				addGround();
				addWorldBiomes();
				addRoads();
				addBuildings();
				addTrees();
				addDecorations();
				addMemoryNodes();
				addCollectibles();
				addGates();
				createParticlePool();
				updateCarObject();
				bindControls();
				resize();
				setHud();

				try {
					await setupPhysics();
					syncCarStateFromPhysics();
					lastFrameTime = performance.now();
					animate();
				} catch (error) {
					console.error(error);
					if (zoneName) zoneName.textContent = 'Physics failed';
					if (zoneHint) zoneHint.textContent = '物理引擎加载失败，请刷新页面再试。';
				}
			};

			startGame();
		</script>
	</body>
</html>
